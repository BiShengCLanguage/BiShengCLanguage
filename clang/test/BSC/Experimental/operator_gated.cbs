// RUN: not %clang -fsyntax-only %s 2>&1 | FileCheck %s --check-prefix=GATED
// RUN: %clang -fbsc-experimental -fsyntax-only %s
// expected-no-diagnostics

// GATED: operator overloading is an experimental BSC feature; enable with -fbsc-experimental

struct E {
  int x;
};

__attribute__((operator +)) int add(struct E a, int b) {
  return a.x + b;
}
