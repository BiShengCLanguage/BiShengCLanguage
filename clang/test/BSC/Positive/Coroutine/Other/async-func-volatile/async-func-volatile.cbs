// expected-no-diagnostics

#include "future.hbs"
#include <stdlib.h>

_Async int read(int a) {
  return 0;
}

_Async volatile int f() {
    int a = 1;
    int b = a - 1;
    int n[10];
    for (int i=0; i<10; i++) {
        n[i] = i + 100;
    }
    return 0;
}

int main()
{
    _Trait Future<volatile int>* this = f();
    this->poll();
    return 0;
}
