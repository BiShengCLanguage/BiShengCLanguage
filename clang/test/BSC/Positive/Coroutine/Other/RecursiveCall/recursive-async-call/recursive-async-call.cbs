// RUN: %clang -fbsc-experimental %s -o %test.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %S/../../../../../../../lib/Headers/bsc_include/future.hbs -o %T/future.h
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// expected-no-diagnostics

// since it's a recursive call, we will get a segv if we run it.

// Test without serialization:
// RUN: %clang_cc1 -fbsc-experimental -triple x86_64-unknown-linux-gnu \
// RUN: -internal-isystem  %S/../../../../../../../lib/Headers/bsc_include \
// RUN: -internal-externc-isystem /usr/include/x86_64-linux-gnu \
// RUN: -internal-externc-isystem /include -internal-externc-isystem /usr/include -ast-dump %s \
// RUN: | FileCheck --strict-whitespace %s
//
// Test with serialization:
// RUN: %clang_cc1 -fbsc-experimental -triple x86_64-unknown-linux-gnu \
// RUN: -internal-isystem  %S/../../../../../../../lib/Headers/bsc_include \
// RUN: -internal-externc-isystem /usr/include/x86_64-linux-gnu \
// RUN: -internal-externc-isystem /include -internal-externc-isystem /usr/include -emit-pch -o %t %s
// RUN: %clang_cc1 -fbsc-experimental -x bsc -triple x86_64-unknown-linux-gnu \
// RUN: -internal-externc-isystem /usr/include/x86_64-linux-gnu \
// RUN: -internal-externc-isystem /include -internal-externc-isystem /usr/include -include-pch %t -ast-dump-all /dev/null \
// RUN: | sed -e "s/ <undeserialized declarations>//" -e "s/ imported//" \
// RUN: | FileCheck --strict-whitespace %s

#include "future.hbs"
#include <stdlib.h>

_Async int f() {
    int a = _Await f();
    return a;
}


// Declaration
// CHECK: |-FunctionDecl {{.*}} <line:30:1, col:12> col:12 __f 'struct _Futuref *(void)'

// Make sure that function `__f` has body.
// CHECK: |-FunctionDecl {{.*}} <col:1, line:33:1> line:30:12 used __f 'struct _Futuref *(void)'
// CHECK-NEXT: | `-CompoundStmt {{.*}} <col:1, line:33:1>
// CHECK-NEXT: |   |-DeclStmt {{.*}} <line:30:1, line:33:1>

int main() {
  _Trait Future<int>* this = f();
  this->poll();
  this->free();
  return 0;
}