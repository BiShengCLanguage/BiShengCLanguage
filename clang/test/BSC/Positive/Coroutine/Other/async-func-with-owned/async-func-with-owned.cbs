// Borrow checking of '_Await' expressions is not implemented yet; the test
// pins that diagnostic. When it is implemented, restore the full positive
// pipeline (compile+run, rewrite-bsc) that this test used to perform.

// XFAIL: *
// RUN: %clang -fbsc-experimental %s -o %test.output
// RUN: %test.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %S/../../../../../../lib/Headers/bsc_include/future.hbs -o %T/future.h
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output
// expected-no-diagnostics

#include "future.hbs"
#include <stdlib.h>
T* _Owned malloc_owned<T>(T value) {
    T * p = (T *) malloc( sizeof(T) );
    *p = value;
    return __take_from_raw(p);
}

void free_owned<T>(T* _Owned p) {
        free( __move_to_raw(p) );
}

struct Owned<T> {
    T* _Owned p;
};

struct Owned<T> make_owned<T>(T value) {
    struct Owned<T> ret= {.p = malloc_owned(value)};
    return ret;
}

_Async int f() {
    return 0;
}

_Async int foo() {
    struct Owned<int> q = make_owned(2);
    int a = _Await f(); // expected-error {{borrow checking of '_Await' expressions is not implemented yet}}
    int * p = __move_to_raw(q.p);
    return a;
}

int main() {
    return 0;
}
