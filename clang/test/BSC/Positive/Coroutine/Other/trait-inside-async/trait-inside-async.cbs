// expected-no-diagnostics
#include "future.hbs"
#include <stdlib.h>

struct A {};

_Trait B {};

_Impl _Trait B for struct A;

struct A* foo() {
    return 0;
}

void bar(_Trait B* x) {
    return;
}


_Async void f() {
    bar(foo());
}

int main() {
  return 0;
}