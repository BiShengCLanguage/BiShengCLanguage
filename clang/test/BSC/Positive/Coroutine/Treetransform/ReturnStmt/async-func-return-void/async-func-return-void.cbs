// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output
// expected-no-diagnostics

#include "future.hbs"
#include <stdlib.h>

_Async int read(int a) {
  return 0;
}

_Async void f(int start) {
  int result = start;
  for (int i = 0; i < start; i++) {
     int a = _Await read(1);
  }
}

int main() {
  _Trait Future<struct Void>* this = f(1);
  this->poll();
  return 0;
}