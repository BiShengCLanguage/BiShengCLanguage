// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output
// expected-no-diagnostics

#include "future.hbs"
#include <stdlib.h>

_Async int read(int a) {
  return 0;
}

_Async int f(int start) {
  int x = 3;
  int z;
  int *ptr;
  ptr = &x;
  z = (x == 3) ? 20 : 30;
  int a = _Await read(1);
  int result = _Await read(1);
  return result;
}

int main() {
  _Trait Future<int>* this = f(1);
  this->poll();
  return 0;
}