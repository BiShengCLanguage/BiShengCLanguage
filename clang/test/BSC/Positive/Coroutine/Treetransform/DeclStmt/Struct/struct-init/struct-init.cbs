#include "future.hbs"
#include <stdlib.h>

_Async int read(int a) {
  return 0;
}

struct Books
{
   char  title[50];
   char  author[50];
   char  subject[100];
   int   book_id;
};

_Async int f(int start) {
  struct Books book1;
  struct Books book = {"C language", "RUNOOB", "programming language", 123456};
  struct Books *pbook;
  int result = _Await read(1);
  return result;
}

int main() {
  _Trait Future<int>* this = f(1);
  this->poll();
  return 0;
}