// RUN: %clang -fbsc-experimental %s -o %test.output
// RUN: %test.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %S/../../../../../../../../lib/Headers/bsc_include/future.hbs -o %T/future.h
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output
// expected-no-diagnostics

#include "future.hbs"
#include <stdlib.h>

_Async int read(int a) {
  return 0;
}

union Data
{
  int i;
  float f;
  char str[20];
};

_Async int f(int start) {
  union Data data;
  data.i = 10;
  data.f = 220.5;
  int result = _Await read(1);
  return result;
}

int main() {
  _Trait Future<int>* this = f(1);
  this->poll();
  return 0;
}