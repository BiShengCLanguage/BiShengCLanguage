// RUN: %clang -fbsc-experimental %s -o %test.output
// RUN: %test.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output

int b = 1;

_Owned struct A {
    _Public:
        int a;
        int f(A* this) { return b; }
};

int A::g() {
    A a = {.a = 1};
    int res = a.f() + a.a;
    return res;
}

int main() {
    int b = A::g();
    return b - 2;
}
