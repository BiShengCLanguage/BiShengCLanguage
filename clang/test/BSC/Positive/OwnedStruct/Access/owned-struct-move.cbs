// RUN: %clang -fbsc-experimental %s -o %test.output
// RUN: %test.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output

int g_flag1 = 0x10;
int g_flag2 = 0x10;
int g_temp = 1;

_Owned struct S1 {
_Public:
	~S1(S1 this) {
	}
};

_Owned struct S2 {
_Public:
	S1 s1;
	~S2(S2 this) {
	}
};

S1 initS1();
S2 initS2(S1);

int main() {
	int i = 0x10;
	while (i--) {
		S1 s1 = {};
		S2 s2 = {s1};
	}
	g_temp = g_flag2;
	return 0;
}
