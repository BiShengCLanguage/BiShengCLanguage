// RUN: %clang -fbsc-experimental %s -o %test.output
// RUN: %test.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output

int g_flag = 0x2;
_Owned struct S<T> {
_Public:
    ~S(S<T> this) {
        g_flag--;
    }
};
int foo() {
  if (0) {
    S<char> s1 = {};
  }
   else if (1) {
    S<char> s1 = {};
  }
  return 0;
}

int goo() {
  if (0) {
    S<char> s1 = {};
  }
  else if (0){
    S<char> s1 = {};
  }
  else {
    S<char> s1 = {};
  }
  
  return 0;
}
int main() {
    foo();
    goo();
    return g_flag;
}