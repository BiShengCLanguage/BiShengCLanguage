int y = 0;
_Owned struct A<T> {  
 _Public:
     int x;
     ~A(A<T> this) {
        y++;
    }
  };
int test_do_while() {
   int n  = 1 ;
   do {
     A<int> aaa = {};
     if (n == 6) {
       break;
     }
     n++;
   } while (n < 7);
   return 0;
}

int main() {
  test_do_while();
  return y-6;
}