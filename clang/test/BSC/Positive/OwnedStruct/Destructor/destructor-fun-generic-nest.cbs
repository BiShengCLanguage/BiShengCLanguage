// RUN: %clang -fbsc-experimental %s -o %test.output
// RUN: %test.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output

_Owned struct A<T> {
_Public:
    int a;
};

_Owned struct B<T> {
_Public:
    char *b;
};

_Owned struct S<T> {
_Public:
    A<T> a;
    B<T> b;
};

int main() {
    char x = 'a';
    A<int> a = {1};
    B<int> b = {&x};
    S<int> s = {a, b};
    return 0;
}