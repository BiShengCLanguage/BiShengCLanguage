int y  = 0;
_Owned struct B{
    ~B(B this){
       y++;
    }
};
_Owned struct A {
_Public:
  static B b;
  ~A( A this) {
    y++;
  }
};
int main() {
    B b ={};
    A a ={b};
   return y-1;
}