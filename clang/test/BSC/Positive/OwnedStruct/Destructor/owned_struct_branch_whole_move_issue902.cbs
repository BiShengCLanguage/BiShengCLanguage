// RUN: %clang -fbsc-experimental %s -o %test.output
// RUN: %test.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output

#include <stdio.h>
int g_flag1 = 1;
int g_flag2 = 1;
int g_temp = 1;
_Owned struct S1 {
_Public:
    ~S1(S1 this) {
        printf("析构S1\n");
        g_flag1--;
    }
};
_Owned struct S2 {
_Public:
    S1 s1;
    ~S2(S2 this) {
        printf("析构S2\n");
        g_flag2--;
    }
};
int foo(){
    S1 s1 = {};
    S2 s2 = {s1}; //s1 move, s1不调用析构
    if(g_flag1) {
        S2 s3 = s2; //s2 move, s2不调用析构
    }
    g_temp = g_flag2;//g_temp == 0, s2则在if block结束时析构，非return时析构
    return 0;
}
int main() {
    foo();
    if (g_temp == 0 && g_flag1 == 0 && g_flag2 == 0) {
        return 0;
    }
    return 1;
}
