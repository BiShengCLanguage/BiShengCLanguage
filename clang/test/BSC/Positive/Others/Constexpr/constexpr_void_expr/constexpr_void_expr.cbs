// RUN: %clang_cc1 -fbsc-experimental -verify %s
// RUN: %clang -fbsc-experimental %s -o %t.output
// RUN: %t.output

// Void-typed expressions, such as the discarded-value expression statement
// `(void)expr;`, are allowed in constexpr function bodies, just like in C++11
// and later.  The operand is still required to be a valid constant
// expression, so this must not make otherwise-invalid bodies valid (see
// Negative/Others/Constexpr/constexpr_function/constexpr_function.cbs).

// expected-no-diagnostics

constexpr int discard_parameter(int n) {
    (void)n;
    (void)(n + 1);
    return n;
}
_Static_assert(discard_parameter(7) == 7, "fail");

constexpr int callee(void) {
    return 5;
}

constexpr int discard_expressions(void) {
    (void)0;
    (void)1.5;
    (void)1, (void)2;
    (void)callee();
    return callee();
}
_Static_assert(discard_expressions() == 5, "fail");

constexpr int discard_in_condition(int n) {
    if ((void)0, n > 0)
        return 1;
    return 0;
}
_Static_assert(discard_in_condition(2) == 1, "fail");
_Static_assert(discard_in_condition(0) == 0, "fail");

int main(void) {
    _Static_assert(discard_parameter(7) == 7, "fail");
    _Static_assert(discard_expressions() == 5, "fail");
    _Static_assert(discard_in_condition(2) == 1, "fail");
    return 0;
}
