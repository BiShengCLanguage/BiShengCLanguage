// RUN: %clang %s -o %t.output
// RUN: %t.output
// RUN: %clang -rewrite-bsc %s -o %t-rw.c
// RUN: %clang %t-rw.c -o %t-rw.output
// RUN: %t-rw.output
// expected-no-diagnostics

enum { FALSE = 0, TRUE = 1 };

int bar<int N>(void) {
    return N;
}

int main(void) {
    if (bar<!FALSE>() != TRUE) return 1;
    if (bar<!TRUE>() != FALSE) return 2;
    return 0;
}
