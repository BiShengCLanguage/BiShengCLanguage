// RUN: %clang -fbsc-experimental %s -o %t.output
// RUN: %t.output
// expected-no-diagnostics

#include <stdlib.h>
#include <string.h>

// Test that _Borrow casts work with template-dependent types
_Safe T *_Nullable _Owned malloc_obj_zero<T>(void) {
  _Unsafe {
    T *_Nullable _Owned destPtr = __take_from_raw((T *)malloc(sizeof(T)));
    if (nullptr != destPtr) {
      // This cast should work: T *mut _Borrow -> void *_Borrow
      _Unsafe { memset((void *)(void *_Borrow) & _Mut * destPtr, 0, sizeof(T)); }
    }
    return destPtr;
  }
}

_Owned struct TestStruct {
_Public:
  int x;
  int y;
};

_Safe int main(void) {
  // Test with int type
  int *_Nullable _Owned ptr1 = malloc_obj_zero<int>();
  if (ptr1 != nullptr) {
    if (*ptr1 != 0) {
      _Unsafe { free(__move_to_raw(ptr1)); }
      return 1;
    }
    _Unsafe { free(__move_to_raw(ptr1)); }
  }

  // Test with struct type
  TestStruct *_Nullable _Owned ptr2 = malloc_obj_zero<TestStruct>();
  if (ptr2 != nullptr) {
    if (ptr2->x != 0 || ptr2->y != 0) {
      _Unsafe { free(__move_to_raw(ptr2)); }
      return 1;
    }
    _Unsafe { free(__move_to_raw(ptr2)); }
  }

  return 0;
}
