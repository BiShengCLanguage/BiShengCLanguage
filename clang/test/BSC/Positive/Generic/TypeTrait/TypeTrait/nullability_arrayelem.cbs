// CHECK: _Bool is_nullable_int_P_Borrow(void);
// CHECK: _Bool is_nullable_void_P_Borrow(void);
// CHECK: _Bool is_nullable_const_void_P_Borrow(void);
// CHECK: _Bool is_nullable_const_int_P_Borrow(void);
// CHECK: _Bool is_nullable_int_P_Owned__Nullable(void);
// CHECK: _Bool is_nullable_int_P_Owned__Nonnull(void);
// CHECK: _Bool is_nullable_int_P_Borrow__Nullable(void);
// CHECK: _Bool is_nullable_int_P_Borrow__Nonnull(void);
// CHECK: _Bool is_nullable_int_P_Borrow_P(void);
// CHECK: _Bool is_nullable_int_P_BorrowLB3RB(void);

// CHECK: _Bool is_arrayelem_void(void);
// CHECK: _Bool is_arrayelem_int(void);
// CHECK: _Bool is_arrayelem_intLBRB(void);
// CHECK: _Bool is_arrayelem_intLB3RB(void);
// CHECK: _Bool is_arrayelem_struct_S(void);
// CHECK: _Bool is_arrayelem_struct_G(void);
// CHECK: _Bool is_arrayelem_enum_E(void);
// CHECK: _Bool is_arrayelem_union_U(void);
// CHECK: _Bool is_arrayelem_struct_SB(void);
// CHECK: _Bool is_arrayelem_int_P(void);
// CHECK: _Bool is_arrayelem_void_P(void);
// CHECK: _Bool is_arrayelem_struct_SB_P(void);
// CHECK: _Bool is_arrayelem_int_P_Nullable(void);
// CHECK: _Bool is_arrayelem_int_P_Nonnull(void);
// CHECK: _Bool is_arrayelem_int_P_Owned(void);
// CHECK: _Bool is_arrayelem_int_P_Borrow(void);
// CHECK: _Bool is_arrayelem_const_int_P_Borrow(void);
// CHECK: _Bool is_arrayelem_int_P_Owned__ArrayElem(void);
// CHECK: _Bool is_arrayelem_int_P_Borrow__ArrayElem(void);
