// CHECK: _Bool is_nullable_intLB3RB(void);
// CHECK: _Bool is_nullable_struct_S(void);
// CHECK: _Bool is_nullable_struct_G(void);
// CHECK: _Bool is_nullable_enum_E(void);
// CHECK: _Bool is_nullable_union_U(void);
