// RUN: %clang_cc1 -triple x86_64-unknown-unknown -ast-dump %s | FileCheck %s
// RUN: %clang_cc1 -triple x86_64-unknown-unknown -emit-pch -o %t %s
// RUN: %clang_cc1 -x bsc -triple x86_64-unknown-unknown -include-pch %t -ast-dump-all /dev/null \
// RUN: | FileCheck %s

int g(int x);
_Safe void cb(void);
typedef _Safe void (*SafeFp)(void);
int ov(int) __attribute__((overloadable));
int ov(double) __attribute__((overloadable));

_Unsafe void zones(int a) {
  SafeFp fp = cb;
  int r = _Safe(a) + _Unsafe(g(a)) + (a);
  int (*p)(int) = _Unsafe(ov);
  (void)fp;
  (void)r;
  (void)p;
}

_Safe int generic<T>(T a) {
  return _Unsafe(g(a));
}

int main(void) { return generic<int>(1); }

// CHECK: FunctionDecl {{.*}} zones 'void (int)'
// CHECK: VarDecl {{.*}} fp 'SafeFp':'_Safe void (*)(void)'
// CHECK: ParenExpr {{.*}} 'int' lvalue _Safe
// CHECK: ParenExpr {{.*}} 'int' _Unsafe
// CHECK: ParenExpr {{.*}} 'int' lvalue{{$}}
// Resolving the overload rebuilds the parentheses.
// CHECK: ParenExpr {{.*}} 'int (int)' _Unsafe
// CHECK: SafeZoneAttr {{.*}} _Unsafe

// CHECK: FunctionDecl {{.*}} generic '_Safe int (T)'
// CHECK: ParenExpr {{.*}} '<dependent type>' _Unsafe
// CHECK: FunctionDecl {{.*}} generic '_Safe int (int)'
// CHECK: TemplateArgument type 'int'
// CHECK: ParenExpr {{.*}} 'int' _Unsafe
// CHECK: SafeZoneAttr {{.*}} _Safe
