// RUN: %clang_cc1 -fsyntax-only -verify -Wno-unused-value %s
// expected-no-diagnostics

// String-literal arms wrapped in GNU binary conditional or comma operator must
// be accepted as `const char *` initializers — same as the direct form and the
// ternary form.

_Safe void direct(void) {
    const char *_Borrow p = "hello";
    (void)p;
}

_Safe void ternary(void) {
    const char *_Borrow p = (1 ? "hello" : "world");
    (void)p;
}

_Safe void bincond_same_arm(void) {
    const char *_Borrow p = ("hello" ?: "world");
    (void)p;
}

_Safe void bincond_distinct_arms(void) {
    const char *_Borrow p = ("a" ?: "b");
    (void)p;
}

_Safe void bincond_raw_target(void) {
    const char *p = ("hello" ?: "world");
    (void)p;
}

_Safe void bincond_predefined(void) {
    const char *_Borrow p = (__func__ ?: "fallback");
    (void)p;
}

_Safe void comma_rhs_string_literal(void) {
    const char *_Borrow p = (0, "hello");
    (void)p;
}

_Safe void comma_raw_target(void) {
    const char *p = (0, "hello");
    (void)p;
}

_Safe void comma_lhs_side_effect(void) {
    int x = 0;
    const char *_Borrow p = (++x, "hello");
    (void)p;
}

_Safe void nested_comma_rhs_string_literal(void) {
    const char *_Borrow p = (0, (1, "hello"));
    (void)p;
}
