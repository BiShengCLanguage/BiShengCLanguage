// CHECK-NEXT: MemberExpr 0x{{[^ ]*}} <col:13, col:24> 'int (struct Foo *_Borrow)' _Safe lvalue ->getC 0x{{[^ ]*}}
// CHECK-NEXT: ImplicitCastExpr 0x{{[^ ]*}} <col:13> 'struct Foo *_Owned' <LValueToRValue>
// CHECK-NEXT: DeclRefExpr 0x{{[^ ]*}} <col:13> 'struct Foo *_Owned' lvalue Var 0x{{[^ ]*}} 'foo_owned' 'struct Foo *_Owned'
// CHECK-NEXT: UnaryOperator 0x{{[^ ]*}} <<invalid sloc>, col:13> 'struct Foo *_Borrow' prefix '&_Mut *' cannot overflow
// CHECK-NEXT: ImplicitCastExpr 0x{{[^ ]*}} <col:13> 'struct Foo *_Owned' <LValueToRValue>
// CHECK-NEXT: DeclRefExpr 0x{{[^ ]*}} <col:13> 'struct Foo *_Owned' lvalue Var 0x{{[^ ]*}} 'foo_owned' 'struct Foo *_Owned'

