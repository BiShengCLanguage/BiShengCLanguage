// RUN: %clang_cc1 -fbsc-experimental -verify %s
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: FileCheck --input-file=%t-rw.c %s
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output
// expected-no-diagnostics

enum E {
  X3
};

int enum E::to_int(enum E* this, int a) { 
  return a;
}

int main() {
  enum E foo = X3; 
  int x = foo.to_int(1);
  return 0;
}

// CHECK: enum E {
// CHECK-NEXT:   X3
// CHECK-NEXT: };

// CHECK: int enum_E_to_int(enum E *this, int a) {
// CHECK-NEXT:   return a;
// CHECK-NEXT: }

// CHECK: int main(void) {
// CHECK-NEXT:   enum E foo = X3;
// CHECK-NEXT:   int x = enum_E_to_int(&foo, 1);
// CHECK-NEXT:   return 0;
// CHECK-NEXT: }
