// RUN: %clang_cc1 -fbsc-experimental -verify %s
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: FileCheck --input-file=%t-rw.c %s
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output
// expected-no-diagnostics

enum E {
  X3
};

int enum E::to_int(enum E* this) { 
  return (int)*this;
}

int main() {
  enum E foo = X3; 
  enum E* f = &foo;
  int x = f->to_int();
  return 0;
}

// CHECK: enum E {
// CHECK-NEXT: X3
// CHECK-NEXT: };

// CHECK: int enum_E_to_int(enum E *this) {
// CHECK-NEXT:   return (int)*this;
// CHECK-NEXT: }

// CHECK: int main(void) {
// CHECK-NEXT:   enum E foo = X3;
// CHECK-NEXT:   enum E *f = &foo;
// CHECK-NEXT:   int x = enum_E_to_int(f);
// CHECK-NEXT:   return 0;
// CHECK-NEXT: }
