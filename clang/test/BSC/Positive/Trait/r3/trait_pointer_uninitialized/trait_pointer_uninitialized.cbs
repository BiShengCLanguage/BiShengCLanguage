// RUN: %clang -fbsc-experimental %s -o %t.output
// RUN: %t.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: FileCheck --input-file=%t-rw.c %s
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output
// expected-no-diagnostics

_Trait F {
  int foo(This* this);
};

int int::foo(int *this) {
  return 10;
};

_Impl _Trait F for int;

int main() {
  int a = 1;
  _Trait F* f;
  f = &a;
  int b = f->foo();
  return b - 10;
}

// CHECK: struct __Trait_F_Vtable {
// CHECK-NEXT: int (*foo)(void *);
// CHECK-NEXT: };

// CHECK: struct __Trait_F {
// CHECK-NEXT: void *data;
// CHECK-NEXT: struct __Trait_F_Vtable *vtable;
// CHECK-NEXT: };

// CHECK: int int_foo(int *this) {
// CHECK-NEXT: return 10;
// CHECK-NEXT: }

// CHECK: struct __Trait_F_Vtable __int_trait_F = {.foo = (int (*)(void *))int_foo};

// CHECK: int main(void) {
// CHECK-NEXT: int a = 1;
// CHECK-NEXT: struct __Trait_F f;
// CHECK-NEXT: f.data = &a , f.vtable = &__int_trait_F;
// CHECK-NEXT: int b = f.vtable->foo(f.data);
// CHECK-NEXT: return b - 10;
// CHECK-NEXT: }