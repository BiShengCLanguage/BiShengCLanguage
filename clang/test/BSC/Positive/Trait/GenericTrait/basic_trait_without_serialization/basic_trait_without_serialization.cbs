struct PollResult<int> int::poll(int* this, int a) {
    struct PollResult<int> p;
    p.c = a;
    return p;
}
// CHECK: BSCMethodDecl 0x{{[^ ]*}} parent 0x{{[^ ]*}} <line:[[@LINE-5]]:1, line:[[@LINE-1]]:1> line:[[@LINE-5]]:29 used poll 'struct PollResult<int> (int *, int)'
