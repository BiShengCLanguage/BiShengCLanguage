// CHECK-NEXT: ImplicitCastExpr 0x{{[^ ]*}} <col:12> 'PollResult<int>':'struct PollResult<int>' <NoOp>
// CHECK-NEXT: DeclRefExpr 0x{{[^ ]*}} <col:12> 'PollResult<int>':'struct PollResult<int>' lvalue Var 0x{{[^ ]*}} 'p' 'PollResult<int>':'struct PollResult<int>'

void int::free(int* this) {}
// CHECK: BSCMethodDecl 0x{{[^ ]*}} parent 0x{{[^ ]*}} <col:1, col:28> col:11 used free 'void (int *)'
// CHECK-NEXT: ParmVarDecl 0x{{[^ ]*}} <col:16, col:21> col:21 this 'int *'
// CHECK-NEXT: CompoundStmt 0x{{[^ ]*}} <col:27, col:28>

_Impl _Trait Future<int> for int;
// CHECK: ImplTraitDecl 0x{{[^ ]*}} <line:[[@LINE-1]]:7, col:30> col:30 Future_int 'int'
// CHECK-NEXT: VarDecl 0x{{[^ ]*}} <col:7, col:30> col:30 __int_trait_Future 'struct __Trait_Future_Vtable<int>':'struct __Trait_Future_Vtable<int>' cinit
// CHECK-NEXT: InitListExpr 0x{{[^ ]*}} <col:7, col:30> 'struct __Trait_Future_Vtable<int>':'struct __Trait_Future_Vtable<int>'
// CHECK-NEXT: CStyleCastExpr 0x{{[^ ]*}} <col:7> 'struct PollResult<int> (*)(void *, int)' <BitCast>
// CHECK-NEXT: ImplicitCastExpr 0x{{[^ ]*}} <col:7> 'struct PollResult<int> (*)(int *, int)' <FunctionToPointerDecay> part_of_explicit_cast
// CHECK-NEXT: DeclRefExpr 0x{{[^ ]*}} <col:7> 'struct PollResult<int> (int *, int)' lvalue BSCMethod 0x{{[^ ]*}} 'poll' 'struct PollResult<int> (int *, int)'
// CHECK-NEXT: CStyleCastExpr 0x{{[^ ]*}} <col:7> 'void (*)(void *)' <BitCast>
// CHECK-NEXT: ImplicitCastExpr 0x{{[^ ]*}} <col:7> 'void (*)(int *)' <FunctionToPointerDecay> part_of_explicit_cast
// CHECK-NEXT: DeclRefExpr 0x{{[^ ]*}} <col:7> 'void (int *)' lvalue BSCMethod 0x{{[^ ]*}} 'free' 'void (int *)'

_Trait Future<int> *f(_Trait Future<int> *a) {
    return a;
}
// CHECK: FunctionDecl 0x{{[^ ]*}} <line:[[@LINE-3]]:1, line:[[@LINE-1]]:1> line:[[@LINE-3]]:21 used f 'struct __Trait_Future<int> (struct __Trait_Future<int>)'
// CHECK-NEXT: ParmVarDecl 0x{{[^ ]*}} <col:23, col:43> col:43 used a 'struct __Trait_Future<int>':'struct __Trait_Future<int>'
// CHECK-NEXT: CompoundStmt 0x{{[^ ]*}} <col:46, line:[[@LINE-3]]:1>
// CHECK-NEXT: ReturnStmt 0x{{[^ ]*}} <line:[[@LINE-5]]:5, col:12>
// CHECK-NEXT: ImplicitCastExpr 0x{{[^ ]*}} <col:12> 'struct __Trait_Future<int>':'struct __Trait_Future<int>' <NoOp>
// CHECK-NEXT: DeclRefExpr 0x{{[^ ]*}} <col:12> 'struct __Trait_Future<int>':'struct __Trait_Future<int>' lvalue ParmVar 0x{{[^ ]*}} 'a' 'struct __Trait_Future<int>':'struct __Trait_Future<int>'

int main() {
    int m = 0;
    _Trait Future<int> *a = &m;
    int b = a->poll(10).c;
    f(a);
    return b - 10;
}
