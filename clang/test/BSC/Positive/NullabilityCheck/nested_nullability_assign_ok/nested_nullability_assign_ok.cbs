// RUN: %clang_cc1 -nullability-check=all -verify %s
// expected-no-diagnostics

void ok(int **raw, int *_Nonnull *nn) {
  int *_Nonnull *a = nn;
  int **b = raw;
  int **c = nn;
}

void from_borrow(int *_Borrow *p) {
  int *_Borrow *p1 = p;
  int *_Borrow _Nullable *p2 = p;
}

void from_owned(int *_Owned *p) {
  int *_Owned *p1 = p;
  int *_Owned _Nullable *p2 = p;
}
