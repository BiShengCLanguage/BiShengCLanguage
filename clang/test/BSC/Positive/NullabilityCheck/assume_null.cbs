// RUN: %clang_cc1 -nullability-check=all -verify %s
// expected-no-diagnostics

// Test __assume_null: asserts a _Nullable pointer is null at this program
// point. After the call the analyzer treats the pointer as definitely null
// (no ownership held, no leak), mirroring `p = nullptr`. Only allowed in
// _Unsafe zones.

_Safe void MemAlloc(void *_Owned _Nullable *_Borrow ptr, unsigned long size);
_Safe void MemFree(void *_Owned _Nullable *_Borrow ptr);

// Core scenario from the proposal: after MemFree the ownership and null state
// are opaque to the analyzer. __assume_null tells it the pointer is now null
// and holds no ownership — no forget() and no `p = nullptr` needed.
_Safe int main(void) {
  int *_Owned _Nullable p = nullptr;
  MemAlloc(_Unsafe((void *_Owned _Nullable *_Borrow)&_Mut p), sizeof(int));
  if (p != nullptr) {
    *p = 2; // ok — narrowed non-null on this branch (BEFORE assume_null)
  }
  MemFree(_Unsafe((void *_Owned _Nullable *_Borrow)&_Mut p));
  _Unsafe { __assume_null(p); }
  // No forget(p): the builtin dropped ownership. No leak at scope end.
  return 0;
}

// __assume_null on a non-owned _Nullable pointer: marks it null; reading it
// afterwards without a null check would be a nullable deref, so the program
// must not touch it.
_Safe void use_raw(int *_Nonnull p);

_Safe int assume_on_borrow_nullable(void) {
  int *_Nullable p = (int *_Nullable)0;
  _Unsafe { __assume_null(p); }
  return 0; // ok — no use of p after the assumption
}

// __assume_null on a struct field nullable owned pointer: drops ownership of
// the field, so no leak is reported for it at scope end.
struct S {
  int *_Owned _Nullable p1;
  int *_Owned _Nullable p2;
  int x;
};

_Safe void MemFreeS(struct S *_Borrow s);

_Safe int assume_on_field(void) {
  struct S s = {};
  MemFreeS(&_Mut s);
  _Unsafe {
    __assume_null(s.p1);
    __assume_null(s.p2);
  }
  // No leak for s.p1 / s.p2: the builtin dropped their ownership.
  return 0;
}

// __assume_null on a field of an owned pointer to a struct (q->p, where q is
// struct T *_Owned): the field is null / handled, so it does not block a later
// move of the whole pointer. q itself still owns the struct allocation; the
// field having been assumed null (not moved) means consuming q is allowed.
struct T {
  int *_Owned _Nullable p;
};

_Safe void consume(struct T *_Owned);

_Safe void assume_on_owned_struct_field(void *_Owned p) {
  struct T *_Owned q = _Unsafe((struct T *_Owned)p);
  _Unsafe { __assume_null(q->p); }
  (void)&_Mut(*(q));
  consume(q);
}

// After __assume_null drops ownership of a single owned field, borrowing that
// field (not consuming the whole pointer) must not be reported as a use of a
// moved value — the field is null / handled, not moved. The struct pointer q
// itself still owns its allocation, so it must still be consumed/freed.
struct U {
  void *_Owned _Nullable p;
};

_Safe void borrow_field(void *_Owned _Nullable *_Borrow p);
_Safe void consume_U(struct U *_Owned);

_Safe void borrow_after_assume_null_field(void *_Owned p) {
  struct U *_Owned q = _Unsafe((struct U *_Owned)p);
  _Unsafe { __assume_null(q->p); }
  borrow_field(&_Mut q->p);
  consume_U(q);
}

// __assume_null is a BSC feature: a plain (non-safe) function using it still
// compiles. Outside a safe zone the call is always allowed.
void test_unsafe_func(void) {
  int *_Nullable p = (int *_Nullable)0;
  __assume_null(p);
}

// __assume_null(*s) on an owned struct pointer: asserts that every _Nullable
// field of *s is null. Ownership of all owned _Nullable fields is dropped, so
// no leak is reported for any field. The struct pointer s itself, however,
// still holds the struct allocation's ownership — it is not set to null by the
// builtin — so s must still be moved or freed before it goes out of scope.
// The struct must not contain a _Nonnull field (see the sema test file for
// that rejection).
struct W {
  int *_Owned _Nullable p1;
  int *_Owned _Nullable p2;
};

struct Inner {
  int *_Owned _Nullable ip;
};

struct Nested {
  struct Inner in;
  int *_Owned _Nullable p;
};

void consume_W(struct W *_Owned);
void consume_Nested(struct Nested *_Owned);

void assume_on_deref_struct(struct W *_Owned s) {
  _Unsafe { __assume_null(*s); }
  // No leak for s.p1, s.p2: the builtin dropped their ownership. s itself is
  // still owned, so it must be moved out to avoid leaking the struct.
  consume_W(s);
}

void assume_on_deref_struct_nested(struct Nested *_Owned s) {
  _Unsafe { __assume_null(*s); }
  // No leak for s.in.ip, s.p: nested fields are covered too. s itself is still
  // owned and must be moved out.
  consume_Nested(s);
}

// __assume_null(*h->w) on an owned struct-pointer FIELD: the field form of
// __assume_null(*s) above — every _Nullable field of the pointee is asserted
// null and its ownership dropped. The field h->w itself still owns the pointee
// allocation and the host h still owns its own, so both must still be disposed
// of (here: the field is freed, the host forgotten).
void safe_free(void *_Owned p);

struct HW {
  struct W *_Owned w;
};

void assume_on_deref_struct_field(struct HW *_Owned h) {
  _Unsafe { __assume_null(*h->w); }
  // No leak for h->w->p1 / h->w->p2: dropped by the builtin.
  safe_free((void *_Owned)h->w);
  _Unsafe { __forget(h); }
}

// The pointee fields being null (handled), not moved, means the field itself
// can also be consumed through a call argument — the same move-out the cast
// path performs — without a partially-moved error. The host is forgotten
// afterwards (its only field was consumed).
void assume_on_deref_struct_field_consume(struct HW *_Owned h) {
  _Unsafe { __assume_null(*h->w); }
  consume_W(h->w);
  _Unsafe { __forget(h); }
}

// __assume_null on a struct VARIABLE `t`: every _Nullable field is asserted
// null and its ownership dropped — no leak for the fields, no use afterwards.
struct Vv { int *_Owned _Nullable p; };
void assume_on_struct_var(struct Vv t) {
  _Unsafe { __assume_null(t); }
  // No leak for t.p: the builtin dropped its ownership.
}

// __assume_null on a struct-typed FIELD ACCESS: `s->in` and `t.in`. The
// sub-struct's _Nullable fields are asserted null and dropped; the host
// (s) must still be moved/freed.
struct InnerV { int *_Owned _Nullable ip; };
struct OuterV { struct InnerV in; };
void consume_OuterV(struct OuterV *_Owned);

void assume_on_struct_field_ptr(struct OuterV *_Owned s) {
  _Unsafe { __assume_null(s->in); }
  // No leak for s->in.ip: dropped. s itself still owned → consume it.
  consume_OuterV(s);
}

void assume_on_struct_field_val(struct OuterV t) {
  _Unsafe { __assume_null(t.in); }
  // No leak for t.in.ip: dropped.
}

// __assume_null on a deep field CHAIN `s->in.in2` / `t.in.in2`: the leaf
// sub-struct's _Nullable field is asserted null and dropped.
struct LeafV { int *_Owned _Nullable p; };
struct MidV { struct LeafV in2; };
struct RootV { struct MidV in; };
void consume_RootV(struct RootV *_Owned);

void assume_on_chain_ptr(struct RootV *_Owned s) {
  _Unsafe { __assume_null(s->in.in2); }
  consume_RootV(s);
}

void assume_on_chain_val(struct RootV t) {
  _Unsafe { __assume_null(t.in.in2); }
}

// === Ownership DROP for struct-typed arguments (the no-leak half) ===
// These inject real non-null ownership via make_owned so the drop is actually
// observable: without __assume_null each owned field would leak. The leak half
// — where a struct POINTER itself still leaks — lives in
// Negative/NullabilityCheck/assume_null_struct_leak.cbs.

int *_Owned make_owned(void);

// __assume_null(t) on a struct-value variable: the owned field's ownership is
// dropped, so no leak is reported for it at scope end.
struct V { int *_Owned _Nullable p; };
void test_struct_var_drop(void) {
  struct V t;
  t.p = make_owned();
  _Unsafe { __assume_null(t); }
} // no leak error: t.p ownership dropped by __assume_null

// __assume_null(t) nested: sub-struct owned field dropped too.
struct NestedV { struct { int *_Owned _Nullable ip; } in; };
void test_struct_var_nested_drop(void) {
  struct NestedV t;
  t.in.ip = make_owned();
  _Unsafe { __assume_null(t); }
} // no leak error: t.in.ip ownership dropped

// __assume_null(t.in): drops ownership of fields under t.in on the struct
// value; no leak for t.in.ip.
struct Outer { struct { int *_Owned _Nullable ip; } in; };
void test_struct_field_val_drop(void) {
  struct Outer t;
  t.in.ip = make_owned();
  _Unsafe { __assume_null(t.in); }
} // no leak error: t.in.ip ownership dropped

// __assume_null on a deep field chain `t.in.in2`: drops ownership of the leaf
// field t.in.in2.p; no leak for it.
struct Leaf { int *_Owned _Nullable p; };
struct Mid { struct Leaf in2; };
struct Root { struct Mid in; };
void test_struct_field_chain_val_drop(void) {
  struct Root t;
  t.in.in2.p = make_owned();
  _Unsafe { __assume_null(t.in.in2); }
} // no leak error: t.in.in2.p ownership dropped

// The sibling builtin gates in the same Sema switch — va_end and the
// raw-transfer builtins — relax via IsInEvaluatedSafeZone() in unevaluated
// contexts; this spelling must likewise compile.
_Safe int f(int *_Nullable p) {
  return (int)sizeof(__assume_null(p));
}

// __assume_null(*t.w) on a struct-value host: the pointee's owned fields are
// dropped (no leak for t.w.p); the field itself still owns its allocation,
// freed here.
struct HV { struct V *_Owned w; };
struct V *_Owned make_V(void);
void test_deref_struct_field_val_drop(void) {
  struct HV t = { make_V() };
  _Unsafe { __assume_null(*t.w); }
  safe_free((void *_Owned)t.w);
} // no leak error: t.w.p ownership dropped, t.w freed

// The S-host form: after __assume_null(*t.w) the pointee field t.w.p is null
// (handled), not moved, so the field can be consumed through a call argument;
// nothing leaks.
void consume_V(struct V *_Owned);
void test_deref_struct_field_val_consume(void) {
  struct HV t = { make_V() };
  _Unsafe { __assume_null(*t.w); }
  consume_V(t.w);
} // no leak error: t.w.p dropped, t.w consumed
