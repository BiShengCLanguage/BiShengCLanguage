// RUN: %clang %s -o %t.output
// RUN: %t.output
// expected-no-diagnostics

// Runtime coverage for the NULL null pointer constant: NULL compares equal to
// a null pointer at run time, and a null check against NULL narrows the
// pointer just like a check against nullptr.

#define NULL ((void *)0)

int g = 42;

_Safe int deref_or_zero(int *_Borrow _Nullable p) {
  if (p != NULL)
    return *p;
  return 0;
}

_Safe int copy_and_check(int *_Borrow _Nullable p) {
  int *_Borrow _Nullable q = (void *)0;
  if (p != NULL)
    q = p;
  if (q == NULL)
    return -1;
  return *q;
}

_Safe int owned_is_null(void) {
  int *_Owned _Nullable p = NULL;
  if (p == NULL)
    return 1;
  return 0;
}

_Safe int owned_cast_is_null(void) {
  int *_Owned _Nullable p = (int *_Owned _Nullable)NULL;
  return p == NULL;
}

_Safe int zero_cast_is_null(void) {
  int *_Owned _Nullable o = (int *_Owned _Nullable)0;
  int *_Borrow _Nullable b = (int *_Borrow _Nullable)0;
  if (b == 0)
    return o == 0 ? 1 : 0;
  return 0;
}

// Equivalent spellings of the null pointer constant compare equal to null.
_Safe int equivalent_spellings_are_null(void) {
  int *p0 = (void *)(0);
  int *p1 = (void *)(1 - 1);
  int *_Owned _Nullable o = (void *)(1 - 1);
  int *_Borrow _Nullable b = (void *)(0);
  if (p0 != (void *)(1 - 1))
    return 0;
  if (p1 != (void *)(0))
    return 0;
  if (b != (void *)(0))
    return 0;
  return o == (void *)(1 - 1) ? 1 : 0;
}

int main(void) {
  if (deref_or_zero(&_Mut g) != 42)
    return 1;
  if (deref_or_zero(NULL) != 0)
    return 2;
  if (copy_and_check(&_Mut g) != 42)
    return 3;
  if (copy_and_check(NULL) != -1)
    return 4;
  if (owned_is_null() != 1)
    return 5;
  if (owned_cast_is_null() != 1)
    return 6;
  if (zero_cast_is_null() != 1)
    return 7;
  if (equivalent_spellings_are_null() != 1)
    return 8;
  return 0;
}
