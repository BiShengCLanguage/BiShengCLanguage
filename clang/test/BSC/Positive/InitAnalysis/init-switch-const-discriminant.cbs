// RUN: %clang_cc1 -fsyntax-only -verify %s

// A constant discriminant selects one case at compile time; the other case
// bodies are never executed, so their reads are not checked.

_Safe int dead_case(void) {
    int x;
    int y = 0;
    switch (0) {
    case 0: y = 1; break;
    case 1: y = x; break;
    }
    return y;
}

_Safe int dead_case_zero(void) {
    int x;
    int y = 0;
    switch (1) {
    case 0: y = x; break;
    case 1: y = 1; break;
    }
    return y;
}

_Safe int dead_default(void) {
    int x;
    int y = 0;
    switch (0) {
    case 0: y = 1; break;
    default: y = x; break;
    }
    return y;
}

_Safe int no_match_no_default(void) {
    int x;
    int y = 0;
    switch (2) { // expected-warning {{no case matching constant switch condition '2'}}
    case 0: y = x; break;
    }
    return y;
}

// The selected case initializes on the only path taken.
_Safe int init_in_selected_case(void) {
    int x;
    switch (1) {
    case 0: break;
    case 1: x = 1; break;
    }
    return x;
}
