// RUN: %clang_cc1 -fsyntax-only -Wno-unused-value -verify %s
// expected-no-diagnostics

// The unselected arm of a constant-condition conditional expression and the
// short-circuited operand of a constant logical operator are never
// evaluated, so their reads are not checked.

_Safe int ternary_false(void) {
    int x;
    int y = 0 ? x : 1;
    return y;
}

_Safe int ternary_true(void) {
    int x;
    int y = 1 ? 1 : x;
    return y;
}

_Safe int gnu_conditional_true(void) {
    int x;
    int y = 1 ?: x;
    return y;
}

_Safe int logical_and_false(void) {
    int x;
    int y = 0 && x;
    return y;
}

_Safe int logical_or_true(void) {
    int x;
    int y = 1 || x;
    return y;
}

_Safe int nested(void) {
    int x;
    int y = 0 ? (1 ? x : 0) : 1;
    return y;
}

// A statement expression in an unselected arm is never evaluated, and a
// constant statement expression is a constant condition.
_Safe int stmtexpr_dead_arm(void) {
    int x;
    int y = 0 ? ({ x; 0; }) : 2;
    return y;
}

_Safe int stmtexpr_dead_logical_and(void) {
    int x;
    int y = 0 && ({ x; 0; });
    return y;
}

_Safe int stmtexpr_constant_condition(void) {
    int x;
    int y = ({ 5; }) ? 1 : x;
    return y;
}
