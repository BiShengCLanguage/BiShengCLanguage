// RUN: %clang_cc1 -fsyntax-only -uninit-check=all %s

// Union initialization takes exactly two forms:
//   1. an initializer at declaration, which covers the whole union;
//   2. a single assignment wholly initializing one variant (or the union).
// A covered union is fully readable through every variant.
// Union read/write is not allowed in safe zone, so use -uninit-check=all.

union U { int a; float b; };
union UP { int *_Nullable p; int v; };

void use_int(int a);
void use_float(float f);
void use_ptr(int *_Nullable p);

// Scalar-variant assignment covers the union.
void test_union_init_a(void) {
    union U u;
    u.a = 42;
    use_int(u.a);
    use_float(u.b);
}

void test_union_init_b(void) {
    union U u;
    u.b = 3.14f;
    use_int(u.a);
    use_float(u.b);
}

// Designated init.
void test_union_designated(void) {
    union U u = {.a = 1};
    use_int(u.a);
    use_float(u.b);
}

// Zero init: {0}.
void test_union_zero(void) {
    union U u = {0};
    use_int(u.a);
    use_float(u.b);
}

// Empty init: {}.
void test_union_empty(void) {
    union U u = {};
    use_int(u.a);
}

// Union with _Nullable pointer.
void test_union_ptr_init(int *_Nullable p) {
    union UP u = {.p = p};
    use_ptr(u.p);
    use_int(u.v);
}

void test_union_ptr_zero(void) {
    union UP u = {0};
    use_ptr(u.p);
}

// --- Union with struct inside ---

struct Inner { int x; int y; };
union UWithStruct { struct Inner s; float f; };

void use_inner(struct Inner v);

// Whole struct-variant assignment covers the union.
void test_union_whole_variant_assign(void) {
    union UWithStruct u;
    u.s = (struct Inner){1, 2};
    use_int(u.s.x);
    use_float(u.f);
    use_inner(u.s);
}

// Scalar-variant assignment covers; the earlier partial write is irrelevant.
void test_union_partial_then_cover(void) {
    union UWithStruct u;
    u.s.x = 1;
    u.f = 3.14f;
    use_int(u.s.y);
}

// Coverage is not undone by a later partial write.
void test_union_cover_then_partial(void) {
    union UWithStruct u;
    u.f = 3.14f;
    u.s.x = 1;
    use_int(u.s.y);
}

// Init float member of union containing struct.
void test_union_struct_float(void) {
    union UWithStruct u;
    u.f = 3.14f;
    use_float(u.f);
    use_int(u.s.x);
}

// Designated init of union containing struct.
void test_union_struct_designated(void) {
    union UWithStruct u = {.s = {1, 2}};
    use_int(u.s.x);
    use_float(u.f);
}

// Empty init of union containing struct.
void test_union_struct_empty(void) {
    union UWithStruct u = {};
    use_int(u.s.x);
}

// --- Struct with union inside ---

union InnerU { int a; float b; };
struct SWithUnion { union InnerU u; int v; };

// Scalar-variant assignment covers the nested union; v separately.
void test_struct_union_init(void) {
    struct SWithUnion s;
    s.u.a = 42;
    s.v = 1;
    use_int(s.u.a);
    use_int(s.v);
}

// Designated init of struct containing union.
void test_struct_union_designated(void) {
    struct SWithUnion s = {.u = {.a = 1}, .v = 2};
    use_int(s.u.a);
    use_int(s.v);
}

// Empty init of struct containing union.
void test_struct_union_empty(void) {
    struct SWithUnion s = {};
    use_int(s.u.a);
    use_int(s.v);
}

// --- Union with union with struct inside ---

union Mid { struct Inner ms; int mv; };
union Outer { union Mid m; float of; };

// A whole-variant write to the outer union covers everything beneath.
void test_deep_outer_scalar(void) {
    union Outer u;
    u.of = 3.14f;
    use_int(u.m.ms.x);
}

// The partial write grants nothing; the outer cover makes all readable.
void test_deep_partial_then_cover(void) {
    union Outer u;
    u.m.ms.x = 1;
    u.of = 3.14f;
    use_int(u.m.ms.y);
}

// --- Struct with union inside (nested) ---

struct Wrap { union UWithStruct uw; int v; };

// Scalar-variant assignment covers the nested union.
void test_wrap_scalar_variant(void) {
    struct Wrap w;
    w.uw.f = 3.14f;
    use_int(w.uw.s.x);
}

// Partial write then a covering assignment.
void test_wrap_partial_then_cover(void) {
    struct Wrap w;
    w.uw.s.x = 1;
    w.uw.f = 3.14f;
    use_int(w.uw.s.y);
}

// Whole-union assignment covers.
void test_wrap_whole_assign(struct Wrap w2) {
    struct Wrap w;
    w.uw = w2.uw;
    use_int(w.uw.s.x);
    use_float(w.uw.f);
}
