// RUN: %clang_cc1 -fsyntax-only -Wno-unused-value -verify %s
// RUN: %clang_cc1 -fsyntax-only -Wno-unused-value -uninit-check=all -verify %s
// expected-no-diagnostics

// Discarding an initialized value reads it legitimately. An assignment or a
// call as a statement yields a value too, but reads nothing extra.

_Safe int f(void);

_Safe void discarded_reads(void) {
    int x = 1;
    x;
    (void)x;
}

_Safe void assignment_statement(void) {
    int x;
    x = 1;      // writes, does not read
    x;
}

_Safe void call_statement(void) {
    f();
}

// An unevaluated operand is not read, however the value would be discarded.

_Safe unsigned long unevaluated(void) {
    int x;
    return sizeof(x) + sizeof(x + 1);
}

// An increment that is never reached is never read.

_Safe void unreachable_increment(void) {
    int x;
    for (; 0; x) { }
}

_Safe void comma_over_initialized(void) {
    int x = 1;
    int y = 2;
    (x, y);
    for (int i = 0; i < 1; i++, x) { }
}

// A cast over an initialized place reads it legitimately.
_Safe void casts_over_initialized(void) {
    int x = 1;
    (int)x;
    (const int)x;
    (long)x;
}

void unsafe_casts_over_initialized(void) {
    int x = 1;
    (int)x;
    (const int)x;
    (long)x;
}

_Safe int safe_contract_casts_after_write(int *_Borrow __attribute__((ensure_init)) out) {
    *out = 7;
    (int)*out;
    (const int)*out;
    (long)*out;
    return 0;
}

int contract_casts_after_write(int *__attribute__((ensure_init)) out) {
    *out = 7;
    (int)*out;
    (const int)*out;
    (long)*out;
    return 0;
}

_Safe int safe_if_ret_casts_after_write(int *_Borrow __attribute__((ensure_init_if_ret(0))) out) {
    *out = 7;
    (int)*out;
    (const int)*out;
    (long)*out;
    return 0;
}

int if_ret_casts_after_write(int *__attribute__((ensure_init_if_ret(0))) out) {
    *out = 7;
    (int)*out;
    (const int)*out;
    (long)*out;
    return 0;
}
