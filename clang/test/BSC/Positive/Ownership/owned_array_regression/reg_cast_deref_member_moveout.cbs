// RUN: %clang_cc1 -verify %s
// expected-no-diagnostics

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) { free(__move_to_raw(p)); }

struct W { int *_Owned *_Owned pp; };

// Both spellings of the same deref move-out must be tracked: `*pp` (a variable
// terminal) already was, while `*w.pp` (a member terminal) was silently
// untracked, so the pointee of the field stayed owned and the scope-end check
// reported a spurious leak on code that frees everything.
void deref_local_ptr(void) {
  int *_Owned inner = safe_malloc(5);
  int *_Owned *_Owned pp = safe_malloc<int *_Owned>(inner);
  safe_free((void *_Owned)*pp);
  safe_free((void *_Owned)pp);
}

void deref_member_ptr(void) {
  struct W w;
  int *_Owned inner = safe_malloc(5);
  w.pp = safe_malloc<int *_Owned>(inner);
  safe_free((void *_Owned)*w.pp);
  safe_free((void *_Owned)w.pp);
}
