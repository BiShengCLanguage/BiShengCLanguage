// RUN: %clang_cc1 -verify %s
// expected-no-diagnostics

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

struct V { int *_Owned arr[2][2]; };
struct W { struct V v[2]; };
struct T3 { int *_Owned arr[2][3]; };

// A field whose type has more than one array level is one aggregate like any
// other field array: releasing every element with a full-range loop per level
// (in the declared dimension order) moves the whole aggregate, and each loop of
// the nest drops the aggregate state on its own back edge.
void test_two_level(void) {
  struct V v = {.arr = {{safe_malloc(1), safe_malloc(2)},
                        {safe_malloc(3), safe_malloc(4)}}};
  for (int i = 0; i < 2; ++i)
    for (int j = 0; j < 2; ++j)
      safe_free((void *_Owned)v.arr[i][j]);
}

// Positional initializer, unequal level lengths.
void test_two_level_unequal(void) {
  struct T3 t = {{{safe_malloc(1), safe_malloc(2), safe_malloc(3)},
                  {safe_malloc(4), safe_malloc(5), safe_malloc(6)}}};
  for (int i = 0; i < 2; ++i)
    for (int j = 0; j < 3; ++j)
      safe_free((void *_Owned)t.arr[i][j]);
}

// Host array level in front of the field's own two levels.
void test_host_and_two_levels(void) {
  struct W w = {
      .v = {{.arr = {{safe_malloc(1), safe_malloc(2)},
                     {safe_malloc(3), safe_malloc(4)}}},
            {.arr = {{safe_malloc(5), safe_malloc(6)},
                     {safe_malloc(7), safe_malloc(8)}}}}};
  for (int i = 0; i < 2; ++i)
    for (int j = 0; j < 2; ++j)
      for (int k = 0; k < 2; ++k)
        safe_free((void *_Owned)w.v[i].arr[j][k]);
}
