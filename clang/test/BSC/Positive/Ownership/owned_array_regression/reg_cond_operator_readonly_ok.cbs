// RUN: %clang_cc1 -verify %s
// expected-no-diagnostics

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

// A conditional operator used as a condition / comparison reads the element
// (no ownership off the aggregate), so its arms must not be treated as
// path-divergent transfers.

void test_readonly_cond(int c) {
  int *_Owned a[3] = {safe_malloc(1), safe_malloc(2), safe_malloc(3)};
  int n = 0;
  for (int i = 0; i < 3; i++) {
    n += (c ? a[i] : a[0]) != nullptr;
  }
  for (int i = 0; i < 3; i++)
    safe_free((void *_Owned)a[i]);
}

void test_readonly_condition(int c) {
  int *_Owned a[3] = {safe_malloc(1), safe_malloc(2), safe_malloc(3)};
  for (int i = 0; i < 3; i++) {
    if ((c ? a[i] : a[0]) != nullptr) {
      continue;
    }
  }
  for (int i = 0; i < 3; i++)
    safe_free((void *_Owned)a[i]);
}
