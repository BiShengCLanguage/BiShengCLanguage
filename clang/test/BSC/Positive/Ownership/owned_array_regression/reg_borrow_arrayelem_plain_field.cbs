// RUN: %clang_cc1 -verify %s
// expected-no-diagnostics

// Writing a plain (non-owned) field of an element of an owned-element array
// must not be treated as an ownership transfer, even when the host aggregate
// is reached through a _Borrow pointer (which the ownership analysis does not
// track).

struct A {
  unsigned v1;
  unsigned *_Owned _Nullable p;
};

struct B {
  unsigned v2;
  struct A a[2];
};

_Safe unsigned f(struct B *_Borrow c) {
  c->a[c->v2].v1 = 1;
  return 0;
}

struct C {
  int v1;
};

struct D {
  struct C in;
  int *_Owned _Nullable p;
};

struct E {
  struct D a[2];
};

_Safe void g(struct E *_Borrow c) {
  c->a[0].in.v1 = 1;
}
