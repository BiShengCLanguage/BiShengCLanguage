// RUN: %clang_cc1 -verify %s
// expected-no-diagnostics

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

struct S {
  int *_Owned a;
  int *_Owned b;
};
void test_independent_fields() {
  struct S s[2] = {{safe_malloc(1), safe_malloc(2)},
                   {safe_malloc(3), safe_malloc(4)}};
  for (int i = 0; i < 2; i++) {
    safe_free((void *_Owned)s[i].a);
    s[i].a = s[i].b;
  }
  for (int i = 0; i < 2; i++) {
    safe_free((void *_Owned)s[i].a);
  }
}

struct T {
  int *_Owned p;
};
void test_null_assign_field() {
  struct T t[2] = {{safe_malloc(1)}, {safe_malloc(2)}};
  for (int i = 0; i < 2; i++) {
    // The field is owned (initializer); clearing it requires moving it out
    // first (a plain `= nullptr` would discard the owned value).
    safe_free((void *_Owned)t[i].p);
    t[i].p = nullptr;
  }
}
