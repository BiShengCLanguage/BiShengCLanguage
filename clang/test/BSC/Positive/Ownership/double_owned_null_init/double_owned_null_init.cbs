// RUN: %clang_cc1 -verify %s
// expected-no-diagnostics

// Regression (umbrella IJP3AP, F23): null-initializing a doubly-_Owned field
// (`int *_Owned _Nullable *_Owned _Nullable f`) was falsely reported as
// `*s.f is leak`. The HandleInitListExpr null-init path moved the field and its
// `.`-prefix subfields to SNullOwnedFields but left the `*`-suffix (deref)
// entries that initBOP adds in SAllOwnedFields, so checkMemoryLeak saw a phantom
// leak. The null-init path now also null-marks the `*`-suffix family.

struct S { int *_Owned _Nullable *_Owned _Nullable f; };
struct DeepS { int *_Owned _Nullable *_Owned _Nullable *_Owned _Nullable f; };
struct MultiS {
  int *_Owned _Nullable *_Owned _Nullable first;
  int *_Owned _Nullable *_Owned _Nullable second;
};
struct Outer { struct S inner; };
struct DeepOuter { struct DeepS inner; };
struct MultiOuter { struct MultiS inner; };
struct Top { struct Outer outer; };
struct TaggedOuter {
  int tag;
  struct S inner;
};

_Safe int null_init(void) {
  struct S s = { .f = nullptr };
  return 0;
}

_Safe int implicit_zero(void) {
  struct S s = {};
  return 0;
}

_Safe int implicit_zero_with_zero_initializer(void) {
  struct S s = {0};
  return 0;
}

_Safe int deep_pointer_null_init(void) {
  struct DeepS s = { .f = nullptr };
  return 0;
}

_Safe int deep_pointer_implicit_zero(void) {
  struct DeepS s = {};
  return 0;
}

_Safe int multiple_owned_fields_null_init(void) {
  struct MultiS s = { .first = nullptr, .second = nullptr };
  return 0;
}

_Safe int multiple_owned_fields_implicit_zero(void) {
  struct MultiS s = {};
  return 0;
}

_Safe int nested_null_init(void) {
  struct Outer o = { .inner = { .f = nullptr } };
  return 0;
}

_Safe int nested_implicit_zero(void) {
  struct Outer o = {};
  return 0;
}

_Safe int deep_nested_implicit_zero(void) {
  struct Top t = {};
  return 0;
}

_Safe int partial_with_explicit_nested_zero(void) {
  struct TaggedOuter o = { .tag = 1, .inner = {} };
  return 0;
}

_Safe int partial_with_explicit_deep_nested_zero(void) {
  struct DeepOuter o = { .inner = {} };
  return 0;
}

_Safe int nested_multiple_owned_fields_zero(void) {
  struct MultiOuter o = {};
  return 0;
}
