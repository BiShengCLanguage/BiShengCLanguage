// RUN: %clang_cc1 -verify %s
// expected-no-diagnostics

// Companion to F22 (umbrella IJP3AP): non-owned control-flow conditions and a
// normally-consumed owned value must stay clean — only a discarded
// _Owned-returning temporary in a condition/for-increment leaks.

_Safe int *_Owned mk(void);
_Safe void consume(int *_Owned);

_Safe void plain_conditions(int c) {
  if (c) {}
  while (c) { break; }
  for (int i = 0; i < 1; i++) {}
  do {} while (c);
}

_Safe void consumed_not_discarded(void) {
  int *_Owned p = mk();
  consume(p);
}
