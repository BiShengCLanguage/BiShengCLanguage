// RUN: %clang %s -o %t.output
// RUN: %t.output
// expected-no-diagnostics

struct S { int x; };

#define ATTR_SET(p) ((p)->x = (p)->x + 1)

void plain_assignment(void) {
  struct S s = {1};
  ATTR_SET(&_Mut s);
  int result = ATTR_SET(&_Mut s);
  int chained;
  chained = ATTR_SET(&_Mut s);
}

// Each RHS borrow ends before evaluation of the destination begins.
void compound_assignment(void) {
  struct S s = {1};
  (&_Mut s)->x += (&_Mut s)->x;
  (&_Mut s)->x -= (&_Mut s)->x;
  (&_Mut s)->x *= (&_Mut s)->x;
  (&_Mut s)->x /= (&_Mut s)->x + 1;
  (&_Mut s)->x %= (&_Mut s)->x + 1;
  (&_Mut s)->x &= (&_Mut s)->x;
  (&_Mut s)->x |= (&_Mut s)->x;
  (&_Mut s)->x ^= (&_Mut s)->x;
  (&_Mut s)->x <<= (&_Mut s)->x;
  (&_Mut s)->x >>= (&_Mut s)->x;
  int result = ((&_Mut s)->x += (&_Mut s)->x);
}

void conditional_rhs(int condition) {
  struct S s = {1};
  (&_Mut s)->x = condition ? (&_Mut s)->x : 0;
  (&_Mut s)->x += condition ? (&_Mut s)->x : 0;
}

struct A { int values[2]; };

// Computing the destination includes a side effect as well as a borrow.
int subscript_destination(void) {
  struct A a = {{1, 2}};
  int i = 0;
  (&_Mut a)->values[i++] = (&_Mut a)->values[0];
  int result = ((&_Mut a)->values[i++] += (&_Mut a)->values[0]);
  return i != 2 || a.values[0] != 1 || a.values[1] != 3 || result != 3;
}

int main(void) {
  return subscript_destination();
}
