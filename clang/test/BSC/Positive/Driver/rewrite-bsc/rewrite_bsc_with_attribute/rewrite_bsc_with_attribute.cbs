// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: FileCheck --input-file=%t-rw.c %s
// RUN: %clang -fbsc-experimental %t-rw.c -I %S -o %t-rw.output
// RUN: %t-rw.output

_Safe int* _Owned hack_malloc(void) {
  int x = 1;
  _Unsafe {
    int* _Owned p = __take_from_raw(&x);
    return p;
  }
}

__attribute__((visibility("default"))) void test1() {
  int* p = __move_to_raw(hack_malloc());
  int a = 1;
}
_Owned struct T {
  __attribute__((unused)) int * a;
};

typedef __attribute__((unused)) int unusedInt;

void test2(){
  _Safe {
    __attribute__((unused)) int a = 1;
  }
  __attribute__((unused)) int a = 1;
}

int main() {
  test1();
  test2();
  return 0;
}

// CHECK:      typedef __attribute__((unused)) int unusedInt;
// CHECK-EMPTY:
// CHECK-NEXT: struct T {
// CHECK-NEXT:     __attribute__((unused)) int *a;
// CHECK-NEXT: };
// CHECK-EMPTY:
// CHECK-NEXT: void struct_T_D(  struct T this);
// CHECK-EMPTY:
// CHECK-NEXT: int * hack_malloc(void) {
// CHECK-NEXT:     int x = 1;
// CHECK-NEXT:     {
// CHECK-NEXT:         int * p = (int *)&x;
// CHECK-NEXT:         return p;
// CHECK-NEXT:     }
// CHECK-NEXT: }
// CHECK-EMPTY:
// CHECK-NEXT:  __attribute__((visibility("default"))) void test1(void) {
// CHECK-NEXT:     int *p = (int *)hack_malloc();
// CHECK-NEXT:     int a = 1;
// CHECK-NEXT: }
// CHECK-EMPTY:
// CHECK-NEXT: void test2(void) {
// CHECK-NEXT:    {
// CHECK-NEXT:         __attribute__((unused)) int a = 1;
// CHECK-NEXT:    }
// CHECK-NEXT:     __attribute__((unused)) int a = 1;
// CHECK-NEXT: }
// CHECK-EMPTY:
// CHECK-NEXT: int main() {
// CHECK-NEXT:    test1();
// CHECK-NEXT:    test2();
// CHECK-NEXT:    return 0;
// CHECK-NEXT: }
// CHECK-EMPTY:
// CHECK-NEXT: void struct_T_D(  struct T this) {
// CHECK-NEXT: }
