// RUN: %clang %s -o %t.output
// RUN: %t.output
// expected-no-diagnostics

typedef struct RefPair {
  int *_Borrow *_Borrow pp;
  int *_Borrow p;
} RefPair;

typedef struct NestedRefPair {
  RefPair pair;
  int tag;
} NestedRefPair;

void use_pair(RefPair p) { (void)p; }
void use_mut(int *_Borrow p) { (void)p; }

void struct_container_multilevel_members_release(void) {
  int a = 1;
  int b = 2;
  int *_Borrow p = &_Mut a;
  RefPair refs = { .pp = &_Mut p, .p = &_Mut b };
  **refs.pp = 3;
  *refs.p = 4;
  a = 5;
  b = 6;
}

void struct_container_nested_members_release(void) {
  int a = 1;
  int b = 2;
  int *_Borrow p = &_Mut a;
  NestedRefPair nested = { .pair = { .pp = &_Mut p, .p = &_Mut b },
                           .tag = 0 };
  **nested.pair.pp = 3;
  *nested.pair.p = 4;
  a = 5;
  b = 6;
}

void struct_container_compound_literal_with_outer_objects(void) {
  int a = 1;
  int b = 2;
  int *_Borrow p = &_Mut a;
  RefPair refs = (RefPair){ .pp = &_Mut p, .p = &_Mut b };
  use_pair(refs);
}

void struct_container_reassign_member_after_rebind(void) {
  int a = 1;
  int b = 2;
  int c = 3;
  int *_Borrow p = &_Mut a;
  RefPair refs = { .pp = &_Mut p, .p = &_Mut b };
  *refs.pp = &_Mut c;
  **refs.pp = 4;
}

int main(void) {
  return 0;
}
