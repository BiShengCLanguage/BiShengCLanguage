// RUN: %clang_cc1 -fsyntax-only -verify %s

// A constant discriminant selects one case at compile time; the selected
// body and everything it falls through into are still checked.

_Safe int selected_case(void) {
    int x;
    int y = 0;
    switch (1) {
    case 0: y = 1; break;
    case 1: y = x; break; // expected-error {{use of uninitialized value: 'x'}}
    }
    return y;
}

_Safe int fallthrough_into_next_case(void) {
    int x;
    int y = 0;
    switch (0) {
    case 0: y = 1;
    case 1: y = x; break; // expected-error {{use of uninitialized value: 'x'}}
    }
    return y;
}

_Safe int selected_default(void) {
    int x;
    int y = 0;
    switch (2) {
    case 0: y = 1; break;
    default: y = x; break; // expected-error {{use of uninitialized value: 'x'}}
    }
    return y;
}
