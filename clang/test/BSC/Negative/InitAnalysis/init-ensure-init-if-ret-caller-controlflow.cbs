// RUN: %clang_cc1 -fsyntax-only -verify %s
// RUN: %clang_cc1 -fsyntax-only -uninit-check=all -verify=expected,all %s

// ==========================================================================
// ensure_init_if_ret(VALUE) — caller side, across control-flow forms.
// After `ret = f(&x)`, `x` is treated as initialized only on the branch that
// proves `ret == VALUE` (via the recognised `==`/`!=` forms). These tests
// check how that credit behaves through for / while / do-while / switch /
// goto in the caller.
// ==========================================================================

_Safe int try_init(int *_Borrow __attribute__((ensure_init_if_ret(0))) out);

// ----- for / while / do-while: check inside the loop body -----------------
// Each iteration re-calls and re-checks, so the use inside `if (r == 0)` is
// credited every time.

_Safe void for_use_in_if(int n) {
    int x;
    for (int i = 0; i < n; i++) {
        int r = try_init(&_Mut x);
        if (r == 0) {
            int y = x;          // OK: credited on the ret==0 branch
            (void)y;
        }
    }
}

_Safe void while_use_in_if(int n) {
    int x;
    while (n > 0) {
        n = n - 1;
        int r = try_init(&_Mut x);
        if (r == 0) {
            int y = x;          // OK
            (void)y;
        }
    }
}

_Safe void dowhile_use_in_if(int n) {
    int x;
    int i = 0;
    do {
        int r = try_init(&_Mut x);
        if (r == 0) {
            int y = x;          // OK
            (void)y;
        }
        i = i + 1;
    } while (i < n);
}

// ERROR: the zero-iteration path reaches the join without the association.
_Safe void for_use_after_loop(int n) {
    int x;
    int r = 1;
    for (int i = 0; i < n; i++)
        r = try_init(&_Mut x);
    if (r == 0) {
        int y = x; // expected-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

// ERROR: the seed IS the cond value, so a zero-iteration loop reaches the
// guarded block with `x` still uninitialized.
_Safe void for_use_after_loop_cond_seed(int n) {
    int x;
    int r = 0;
    for (int i = 0; i < n; i++)
        r = try_init(&_Mut x);
    if (r == 0) {
        int y = x; // expected-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

// ERROR: the seed is not a constant, so a zero-iteration loop may reach the
// guarded block with `x` uninitialized.
_Safe int opaque_status(void);
_Safe void for_use_after_loop_unknown_seed(int n) {
    int x;
    int r = opaque_status();
    for (int i = 0; i < n; i++)
        r = try_init(&_Mut x);
    if (r == 0) {
        int y = x; // expected-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

// ----- goto ---------------------------------------------------------------

// OK: only the ret==0 edge jumps to `use`, so `x` is initialized there.
_Safe void goto_to_use(void) {
    int x;
    int r = try_init(&_Mut x);
    if (r == 0)
        goto use;
    return;
use:
    {
        int y = x;              // OK: reached only when ret==0
        (void)y;
    }
}

// OK: jump away on failure; the fall-through is the ret==0 path.
_Safe void goto_skip_on_fail(void) {
    int x;
    int r = try_init(&_Mut x);
    if (r != 0)
        goto skip;
    {
        int y = x;              // OK: fall-through is ret==0
        (void)y;
    }
skip: ;
}

// ----- switch -------------------------------------------------------------

// ERROR (documented limitation): switching on the return value directly is
// NOT one of the recognised forms (only the `==`/`!=` comparisons are), so
// the `case 0:` arm does not credit `x`.
_Safe void switch_on_ret(void) {
    int x;
    int r = try_init(&_Mut x);
    switch (r) {
    case 0: {
        int y = x; // expected-error {{use of uninitialized value: 'x'}}
        (void)y;
        break;
    }
    default:
        break;
    }
}

// ERROR: the association is lost at a join unless every path carries it.
_Safe void caller_delegate_cond(int c) {
    int x;
    int r = c ? try_init(&_Mut x) : -1;
    if (r == 0) {
        int y = x; // expected-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

_Safe void caller_other_arm_is_cond(int c) {
    int x;
    int r = c ? try_init(&_Mut x) : 0;
    if (r == 0) {
        int y = x; // expected-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

// A plain local is checked in an unsafe function only under -uninit-check=all.
void unsafe_caller_delegate_cond(int c) {
    int x;
    int r = c ? try_init(&_Mut x) : -1;
    if (r == 0) {
        int y = x; // all-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

void unsafe_caller_other_arm_is_cond(int c) {
    int x;
    int r = c ? try_init(&_Mut x) : 0;
    if (r == 0) {
        int y = x; // all-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

void unsafe_for_use_after_loop(int n) {
    int x;
    int r = 1;
    for (int i = 0; i < n; i++)
        r = try_init(&_Mut x);
    if (r == 0) {
        int y = x; // all-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

void unsafe_for_use_after_loop_cond_seed(int n) {
    int x;
    int r = 0;
    for (int i = 0; i < n; i++)
        r = try_init(&_Mut x);
    if (r == 0) {
        int y = x; // all-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

void unsafe_for_use_after_loop_unknown_seed(int n) {
    int x;
    int r = opaque_status();
    for (int i = 0; i < n; i++)
        r = try_init(&_Mut x);
    if (r == 0) {
        int y = x; // all-error {{use of uninitialized value: 'x'}}
        (void)y;
    }
}

// ERROR: a path that wrote the field itself does not carry the association.
struct Pair { int a; int b; };
struct Outer { struct Pair in; int c; };

_Safe void field_written_on_other_path(int c) {
    struct Pair s;
    int r;
    if (c)
        r = try_init(&_Mut s.a);
    else {
        s.a = 1;
        r = 0;
    }
    if (r == 0) {
        int y = s.a; // expected-error {{use of possibly uninitialized value: 's.a'}}
        (void)y;
    }
}

_Safe void whole_struct_written_on_other_path(int c) {
    struct Pair s;
    int r;
    if (c)
        r = try_init(&_Mut s.a);
    else {
        s.a = 1;
        s.b = 2;
        r = 0;
    }
    if (r == 0) {
        int y = s.a; // expected-error {{use of possibly uninitialized value: 's.a'}}
        (void)y;
    }
}

_Safe void enclosing_struct_written_on_other_path(int c) {
    struct Outer o;
    int r;
    if (c)
        r = try_init(&_Mut o.in.a);
    else {
        o.in.a = 1;
        o.in.b = 2;
        r = 0;
    }
    if (r == 0) {
        int y = o.in.a; // expected-error {{use of possibly uninitialized value: 'o.in.a'}}
        (void)y;
    }
}

_Safe void other_field_written_on_other_path(int c) {
    struct Pair s;
    s.b = 0;
    int r;
    if (c)
        r = try_init(&_Mut s.a);
    else {
        s.b = 1;
        r = 0;
    }
    if (r == 0) {
        int y = s.a; // expected-error {{use of uninitialized value: 's.a'}}
        (void)y;
    }
}

void unsafe_field_written_on_other_path(int c) {
    struct Pair s;
    int r;
    if (c)
        r = try_init(&_Mut s.a);
    else {
        s.a = 1;
        r = 0;
    }
    if (r == 0) {
        int y = s.a; // all-error {{use of possibly uninitialized value: 's.a'}}
        (void)y;
    }
}

void unsafe_other_field_written_on_other_path(int c) {
    struct Pair s;
    s.b = 0;
    int r;
    if (c)
        r = try_init(&_Mut s.a);
    else {
        s.b = 1;
        r = 0;
    }
    if (r == 0) {
        int y = s.a; // all-error {{use of uninitialized value: 's.a'}}
        (void)y;
    }
}

// ERROR: the same for a write to an enclosing struct or union.
union Num { int i; long l; };
struct Tagged { union Num n; int tag; };

_Safe void enclosing_struct_assigned_on_other_path(int c, struct Pair p) {
    struct Outer o;
    int r;
    if (c)
        r = try_init(&_Mut o.in.a);
    else {
        o.in = p;
        r = 0;
    }
    if (r == 0) {
        int y = o.in.a; // expected-error {{use of uninitialized value: 'o.in.a'}}
        (void)y;
    }
}

_Safe void sibling_of_enclosing_struct_written(int c) {
    struct Outer o;
    o.c = 0;
    o.in.b = 0;
    int r;
    if (c)
        r = try_init(&_Mut o.in.a);
    else {
        o.c = 1;
        r = 0;
    }
    if (r == 0) {
        int y = o.in.a; // expected-error {{use of uninitialized value: 'o.in.a'}}
        (void)y;
    }
}

void union_variant_written_on_other_path(int c) {
    struct Tagged t;
    int r;
    if (c)
        r = try_init(&_Mut t.n.i);
    else {
        t.n.l = 1;
        r = 0;
    }
    if (r == 0) {
        int y = t.n.i; // all-error {{use of possibly uninitialized value: 't.n'}}
        (void)y;
    }
}

void union_untouched_on_other_path(int c) {
    struct Tagged t;
    t.tag = 0;
    int r;
    if (c)
        r = try_init(&_Mut t.n.i);
    else {
        t.tag = 1;
        r = 0;
    }
    if (r == 0) {
        int y = t.n.i; // all-error {{use of uninitialized value: 't.n'}}
        (void)y;
    }
}

// The same through the fields of a contract pointee.
_Safe void safe_pointee_field(struct Pair *_Borrow __attribute__((ensure_init)) out, int c) {
    int r;
    if (c)
        r = try_init(&_Mut out->a);
    else {
        out->a = 1;
        r = 0;
    }
    if (r == 0) {
        int y = out->a; // expected-error {{use of uninitialized '*out' in __attribute__((ensure_init)) function}}
        (void)y;
    }
    out->a = 1;
    out->b = 2;
}

_Safe void safe_pointee_other_field(struct Pair *_Borrow __attribute__((ensure_init)) out, int c) {
    int r;
    if (c)
        r = try_init(&_Mut out->a);
    else {
        out->b = 1;
        r = 0;
    }
    if (r == 0) {
        int y = out->a; // expected-error {{use of uninitialized '*out' in __attribute__((ensure_init)) function}}
        (void)y;
    }
    out->a = 1;
    out->b = 2;
}

void pointee_field(struct Pair *_Borrow __attribute__((ensure_init)) out, int c) {
    int r;
    if (c)
        r = try_init(&_Mut out->a);
    else {
        out->a = 1;
        r = 0;
    }
    if (r == 0) {
        int y = out->a; // expected-error {{use of uninitialized '*out' in __attribute__((ensure_init)) function}}
        (void)y;
    }
    out->a = 1;
    out->b = 2;
}

_Safe int safe_if_ret_pointee_field(struct Pair *_Borrow __attribute__((ensure_init_if_ret(0))) out, int c) {
    int r;
    if (c)
        r = try_init(&_Mut out->a);
    else {
        out->a = 1;
        r = 0;
    }
    if (r == 0) {
        int y = out->a; // expected-error {{use of uninitialized '*out' in __attribute__((ensure_init_if_ret)) function}}
        (void)y;
    }
    out->a = 1;
    out->b = 2;
    return 0;
}

int if_ret_pointee_other_field(struct Pair *_Borrow __attribute__((ensure_init_if_ret(0))) out, int c) {
    int r;
    if (c)
        r = try_init(&_Mut out->a);
    else {
        out->b = 1;
        r = 0;
    }
    if (r == 0) {
        int y = out->a; // expected-error {{use of uninitialized '*out' in __attribute__((ensure_init_if_ret)) function}}
        (void)y;
    }
    out->a = 1;
    out->b = 2;
    return 0;
