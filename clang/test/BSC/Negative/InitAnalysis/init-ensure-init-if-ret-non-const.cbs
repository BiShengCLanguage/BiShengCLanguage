// RUN: %clang_cc1 -fsyntax-only -verify %s

// Only an integer constant expression is a constant return or comparison
// value. A variable that happens to hold a constant is not one.

_Safe int try_init(int *_Borrow __attribute__((ensure_init_if_ret(0))) out);

_Safe int ret_local(int a, int *_Borrow __attribute__((ensure_init_if_ret(0))) out) {
    int t = 2;
    if (a) {
        return t; // expected-error {{cannot verify __attribute__((ensure_init_if_ret(0))) contract for '*out': return value is not an integer constant, so the runtime value may equal the cond value — '*out' must be initialized on this path}}
    }
    *out = 1;
    return 0;
}

_Safe int ret_ternary(int c, int *_Borrow __attribute__((ensure_init_if_ret(0))) out) {
    return c ? 1 : 2; // expected-error {{cannot verify __attribute__((ensure_init_if_ret(0))) contract for '*out': return value is not an integer constant, so the runtime value may equal the cond value — '*out' must be initialized on this path}}
}

_Safe int ret_arith_on_local(int a, int *_Borrow __attribute__((ensure_init_if_ret(0))) out) {
    return a - a; // expected-error {{cannot verify __attribute__((ensure_init_if_ret(0))) contract for '*out': return value is not an integer constant, so the runtime value may equal the cond value — '*out' must be initialized on this path}}
}

// A constant return equal to the cond still requires initialization.
_Safe int ret_const_equal_cond(int *_Borrow __attribute__((ensure_init_if_ret(0))) out) {
    return 1 - 1; // expected-error {{'*out' not initialized at return in __attribute__((ensure_init_if_ret(0))) function}}
}

_Safe int cmp_local(void) {
    int x;
    int zero = 0;
    int r = try_init(&_Mut x);
    if (r == zero)
        return x; // expected-error {{use of uninitialized value: 'x'}}
    return 0;
}
