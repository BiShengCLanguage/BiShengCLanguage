// RUN: %clang_cc1 -fsyntax-only -verify %s

// Test ensure_init function pointer compatibility:
// - Target has ensure_init but source doesn't → error
// - Source has ensure_init but target doesn't → ok (stronger to weaker)
// - Both have it → ok
// - Neither has it → ok

typedef _Safe void (*FP1)(int *_Borrow __attribute__((ensure_init)));
typedef _Safe void (*FP2)(int *_Borrow);

_Safe void foo(int *_Borrow);
_Safe void bar(int *_Borrow __attribute__((ensure_init)));

// Variable initialization
_Safe void test_init(void) {
    FP1 p1 = foo; // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
    FP1 p2 = bar; // ok
    FP2 p3 = foo; // ok
    FP2 p4 = bar; // ok
}

// Variable assignment
_Safe void test_assign(void) {
    FP1 fp1;
    fp1 = foo; // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
    fp1 = bar; // ok

    FP2 fp2;
    fp2 = foo; // ok
    fp2 = bar; // ok
}

// Function call argument passing
_Safe void take_fp1(FP1 fn);
_Safe void test_arg_passing(void) {
    take_fp1(foo); // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
    take_fp1(bar); // ok
}

// Multiple parameters: only some have ensure_init
typedef _Safe void (*FP3)(int *_Borrow __attribute__((ensure_init)), int *_Borrow);
_Safe void baz(int *_Borrow, int *_Borrow);
_Safe void qux(int *_Borrow __attribute__((ensure_init)), int *_Borrow);

_Safe void test_multi_param(void) {
    FP3 p1 = baz; // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
    FP3 p2 = qux; // ok
}

// The rule is a type rule, so implicit conversions are rejected outside the
// safe zone too; only an explicit cast in an unsafe zone is exempt.
void unsafe_foo(int *_Borrow);
void unsafe_bar(int *_Borrow __attribute__((ensure_init)));
typedef void (*UFP1)(int *_Borrow __attribute__((ensure_init)));
typedef void (*UFP2)(int *_Borrow);
struct Holder { UFP1 cb; };
void unsafe_take_fp1(UFP1 fn);

UFP1 unsafe_global = unsafe_foo; // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}

void test_unsafe_zone(void) {
    UFP1 p1 = unsafe_foo; // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
    UFP1 p2;
    p2 = unsafe_foo; // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
    unsafe_take_fp1(unsafe_foo); // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
    struct Holder h = { unsafe_foo }; // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
    UFP1 arr[1] = { unsafe_foo }; // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
    UFP1 p3 = (UFP1)unsafe_foo; // ok: explicit cast in an unsafe zone
    UFP1 p4 = unsafe_bar; // ok
    UFP2 p5 = unsafe_bar; // ok: stronger to weaker
    (void)p1; (void)p2; (void)h; (void)arr; (void)p3; (void)p4; (void)p5;
}

UFP1 test_unsafe_return(void) {
    return unsafe_foo; // expected-error {{incompatible function pointer types: target expects __attribute__((ensure_init)) on parameter 0 but source does not have it}}
}
