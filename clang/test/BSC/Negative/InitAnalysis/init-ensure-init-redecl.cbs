// RUN: %clang_cc1 -fsyntax-only -verify %s

// Test ensure_init on redeclarations.
// Rule: same-safety redeclarations must match ensure_init exactly.
// Heterogeneous (_Safe vs non-safe) redeclarations are separate overloads.

// --- Same-safety: both have ensure_init — OK ---

_Safe void foo(int *__attribute__((ensure_init)) _Borrow out);
_Safe void foo(int *__attribute__((ensure_init)) _Borrow out) {
    *out = 1;
}

// Callee contract enforced: empty body → error.
_Safe void bar(int *__attribute__((ensure_init)) _Borrow out);
_Safe void bar(int *__attribute__((ensure_init)) _Borrow out) {
} // expected-error {{'*out' not initialized at return in __attribute__((ensure_init)) function}}

// Caller side works.
_Safe void test_caller(void) {
    int x;
    foo(&_Mut x);
    int y = x;
}

// Chain call with consistent ensure_init.
_Safe void init_int(int *__attribute__((ensure_init)) _Borrow out);
_Safe void init_int(int *__attribute__((ensure_init)) _Borrow out) {
    *out = 99;
}

_Safe void init_x(int *__attribute__((ensure_init)) _Borrow out);
_Safe void init_x(int *__attribute__((ensure_init)) _Borrow out) {
    init_int(out);
}

_Safe int use_val(int v);

_Safe int test_chain(void) {
    int x;
    init_x(&_Mut x);
    int y = use_val(x);
    return y;
}

// --- Heterogeneous: ensure_init differences allowed ---

struct stat {
    unsigned int st_dev;
    unsigned int st_ino;
    unsigned int st_mode;
    unsigned int st_nlink;
    unsigned int st_size;
};

#define S_IFDIR 0040000

int lstat(const char *path, struct stat *__attribute__((ensure_init)) buf);

_Safe int is_directory(const char *_Borrow path) {
    struct stat dirStat;
    int ret = _Unsafe(lstat((const char *)path, &dirStat));
    if (ret == -1 || !(S_IFDIR & dirStat.st_mode))
        return 0;
    return 1;
}

// Unsafe with ensure_init, _Safe without — ERROR (_Unsafe must not carry ensure_init that _Safe lacks).
void hetero_ei(int *__attribute__((ensure_init)) out); // expected-note {{previous declaration is here}}
_Safe void hetero_ei(int *_Borrow out) { // expected-error {{__attribute__((ensure_init)) on parameter 'out' of _Unsafe declaration requires the matching _Safe declaration to carry the same attribute}}
    *out = 1;
}

// _Safe with ensure_init, unsafe without — allowed (different safety).
_Safe void hetero_ei2(int *__attribute__((ensure_init)) _Borrow out);
void hetero_ei2(int *out) {
    *out = 1;
}

// --- Same-safety mismatch: ERROR ---

// _Safe/_Safe: first has, second doesn't.
_Safe void mismatch_safe(int *__attribute__((ensure_init)) _Borrow out); // expected-note {{previous declaration is here}}
_Safe void mismatch_safe(int *_Borrow out) { // expected-error {{conflicting __attribute__((ensure_init)) on parameter 'out' in redeclaration of 'mismatch_safe'}}
    *out = 1;
}

// _Safe/_Safe: first doesn't, second adds.
_Safe void mismatch_safe_add(int *_Borrow out); // expected-note {{previous declaration is here}}
_Safe void mismatch_safe_add(int *__attribute__((ensure_init)) _Borrow out) { // expected-error {{conflicting __attribute__((ensure_init)) on parameter 'out' in redeclaration of 'mismatch_safe_add'}}
    *out = 1;
}

// default/default: first has, second doesn't.
void mismatch_unsafe(int *__attribute__((ensure_init)) out); // expected-note {{previous declaration is here}}
void mismatch_unsafe(int *out) { // expected-error {{conflicting __attribute__((ensure_init)) on parameter 'out' in redeclaration of 'mismatch_unsafe'}}
    *out = 1;
}

// default/default: first doesn't, second adds.
void mismatch_add(int *out); // expected-note {{previous declaration is here}}
void mismatch_add(int *__attribute__((ensure_init)) out) { // expected-error {{conflicting __attribute__((ensure_init)) on parameter 'out' in redeclaration of 'mismatch_add'}}
    *out = 1;
}

// --- Heterogeneous ensure_init_if_ret: cross-safety ---

// _Unsafe with ensure_init_if_ret, _Safe without — ERROR.
int hetero_eiir(int *__attribute__((ensure_init_if_ret(0))) out); // expected-note {{previous declaration is here}}
_Safe int hetero_eiir(int *_Borrow out) { // expected-error {{__attribute__((ensure_init_if_ret(0))) on parameter 'out' of _Unsafe declaration requires the matching _Safe declaration to carry the same attribute with the same argument}}
    *out = 1;
    return 0;
}

// _Safe with ensure_init_if_ret, _Unsafe without — allowed.
_Safe int hetero_eiir2(int *__attribute__((ensure_init_if_ret(0))) _Borrow out);
int hetero_eiir2(int *out) {
    *out = 1;
    return 0;
}

// --- Same-safety ensure_init_if_ret mismatch: ERROR ---

// Both default: first has, second doesn't.
int mismatch_eiir1(int *__attribute__((ensure_init_if_ret(0))) out); // expected-note {{previous declaration is here}}
int mismatch_eiir1(int *out) { // expected-error {{conflicting __attribute__((ensure_init_if_ret)) on parameter 'out' in redeclaration of 'mismatch_eiir1'}}
    *out = 1;
    return 0;
}

// Both _Safe: first has, second doesn't.
_Safe int mismatch_eiir2(int *__attribute__((ensure_init_if_ret(0))) _Borrow out); // expected-note {{previous declaration is here}}
_Safe int mismatch_eiir2(int *_Borrow out) { // expected-error {{conflicting __attribute__((ensure_init_if_ret)) on parameter 'out' in redeclaration of 'mismatch_eiir2'}}
    *out = 1;
    return 0;
}
