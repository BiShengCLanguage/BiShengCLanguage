// RUN: %clang_cc1 -fbsc-experimental -nullability-check=all -verify %s

_Safe T *_Owned safe_malloc<T>(T t);
_Safe void safe_free(void *_Owned p);

_Owned struct B{
    _Public:
    int * _Owned p;
    int pp;
    ~B(B this){
        safe_free((void*_Owned)this.p);
    }
};

_Owned struct A{
    _Public:
    B b;
    int * _Owned p;
    int * q;
    int * _Nullable nq;
    ~A(A this){
        safe_free((void* _Owned)this.p);
    }
};

void test1(){
    A a = {};// #1
    B b = {};// expected-error {{cannot implicitly initialize 'b' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'b' or declare them as '_Nullable'}}
}
// expected-error@#1 {{cannot implicitly initialize 'a' because it contains '_Nonnull' pointer}} expected-note@#1 {{add explicit initializer for '_Nonnull' pointers inside 'a' or declare them as '_Nullable'}}

void test2(){
    B b ={};// expected-error {{cannot implicitly initialize 'b' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'b' or declare them as '_Nullable'}}
    A a = {.b=b};// expected-error {{cannot implicitly initialize 'a' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'a' or declare them as '_Nullable'}}
    A c = {};// expected-error {{cannot implicitly initialize 'c' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'c' or declare them as '_Nullable'}}
}

void test3(){
    B b = {.p=nullptr};// expected-error {{nonnull pointer cannot be assigned by nullable pointer}}
    A a = {.b=b};// expected-error {{cannot implicitly initialize 'a' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'a' or declare them as '_Nullable'}}
}

void test4(){
    B b = {.p=safe_malloc(42)};
    A a = {.b=b};// expected-error {{cannot implicitly initialize 'a' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'a' or declare them as '_Nullable'}}
}

void test5(){
    A a ={.b={safe_malloc(42)},.p=safe_malloc(420)};
}
