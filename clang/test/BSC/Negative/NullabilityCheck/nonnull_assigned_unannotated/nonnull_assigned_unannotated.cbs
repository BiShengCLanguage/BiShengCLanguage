// RUN: %clang_cc1 -nullability-check=all -verify %s

void from_raw(int **raw) {
  int *_Nonnull *p = raw; // expected-error {{nonnull pointer cannot be assigned by nullable pointer}} expected-warning {{incompatible pointer types}}
}

void from_nullable(int *_Nullable *nb) {
  int *_Nonnull *p = nb; // expected-error {{nonnull pointer cannot be assigned by nullable pointer}} expected-warning {{incompatible pointer types}}
}

void from_borrow_nullable(int *_Borrow _Nullable *raw) {
  int *_Borrow *p = raw; // expected-error {{nonnull pointer cannot be assigned by nullable pointer}} expected-warning {{incompatible pointer types}}
}

void from_owned_nullable(int *_Owned _Nullable *raw) {
  int *_Owned *p = raw; // expected-error {{nonnull pointer cannot be assigned by nullable pointer}} expected-warning {{incompatible pointer types}}
}
