// RUN: %clang_cc1 -nullability-check=all -verify %s

// Without -fbsc-diag=exhaustive (default mode), BSC analysis keeps the
// original TU-global gating: once a non-BSC error has been seen, later
// functions in the translation unit are not analyzed.

void *malloc(unsigned long);

void broken() {
  undeclared_identifier_here; // expected-error {{use of undeclared identifier 'undeclared_identifier_here'}}
}

void good() {
  int *p = (int *)malloc(sizeof(int) * 2);
  *p = 3; // No expected diagnostic: default mode skips analysis after broken().
}
