// RUN: %clang_cc1 -verify %s

_Safe void foo1(int *_Borrow a);
_Safe void test1(void) {
    int a = 10;
    int *_Borrow p1 = &_Mut a;
    foo1(p1);
    int *_Borrow _Nullable p2 = &_Mut a;
    foo1(p2);
    int *_Borrow _Nullable p3 = nullptr;
    foo1(p3);            // expected-error {{cannot pass possibly-null status pointer 'p3' to a '_Nonnull' parameter}}
    foo1(&_Mut a);
    foo1(nullptr);       // expected-error {{cannot pass a possibly-null status pointer to a '_Nonnull' parameter}}
}
