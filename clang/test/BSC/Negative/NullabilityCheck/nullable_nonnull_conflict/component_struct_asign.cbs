// RUN: %clang_cc1 -nullability-check=all -verify %s

int *_Nullable foo() {
    return nullptr;
}

struct inside{
    int* _Nonnull p;
};

struct mid{
    struct inside c1;
};

struct out{
    struct inside a;
    struct mid b;
    int* _Nonnull pt;
};

struct simOut{
    struct inside a;
};

void test1(void){
    struct inside a = (struct inside){ nullptr };// expected-error {{cannot assign a possibly-null status pointer to a '_Nonnull' pointer}}
}

void test2(void){
    struct mid m = { { nullptr } };// expected-error {{cannot assign a possibly-null status pointer to a '_Nonnull' pointer}}
}

void test3(void){
    struct out o = { // expected-error {{cannot assign a possibly-null status pointer to a '_Nonnull' pointer}}
        {nullptr},
        {{nullptr}},
        nullptr
    };
}

void test4(){
    struct simOut o1={(struct inside)(struct inside){nullptr}};// expected-error {{cannot assign a possibly-null status pointer to a '_Nonnull' pointer}}
    struct simOut o2={(struct inside)(struct inside){}};// expected-error {{cannot implicitly initialize 'o2' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'o2' or declare them as '_Nullable'}}
}

void test5(void){
    int * _Nullable p0 = nullptr;
    struct inside a = (struct inside){ p0 };// expected-error {{cannot assign possibly-null status pointer 'p0' to a '_Nonnull' pointer}}
    struct inside b = (struct inside){ foo() };// expected-error {{cannot assign a possibly-null status pointer to a '_Nonnull' pointer}}
}
