// RUN: %clang_cc1 -verify %s

struct S {
    int *_Borrow _Nullable p;
};
_Safe int *_Borrow _Nullable get_random_ptr(int *_Borrow p);
_Safe void test1(void) {
    int a = 10;
    struct S s = { .p = nullptr };
    while (s.p == nullptr) {
        s.p = get_random_ptr(&_Mut a); // expected-error {{cannot borrow 'a' as mutable more than once at a time}}
                                      // expected-note@-1 {{first mut borrow occurs here}}
    }
    *s.p = 20;
}

_Safe void test2(void) {
    int a = 10;
    struct S s = { .p = nullptr };
    while (s.p != nullptr) {
        *s.p = 10;
        s.p = get_random_ptr(&_Mut a);
    }
    *s.p = 20;  // expected-error {{cannot dereference possibly-null status pointer 'p'}}
}

_Safe void test3(void) {
    int a = 10;
    struct S s = { .p = nullptr };
    if (s.p != nullptr) {
        do {
            *s.p = 10;
            s.p = get_random_ptr(&_Mut a);
        } while (s.p != nullptr);
        *s.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
    }
}

_Safe void test4(void) {
    int a = 10;
    int b = 10;
    struct S s1 = { .p = nullptr };
    struct S s2 = { .p = nullptr };
    while (s1.p == nullptr || s2.p == nullptr) {
        s1.p = get_random_ptr(&_Mut a); // expected-error {{cannot borrow 'a' as mutable more than once at a time}}
                                       // expected-note@-1 {{first mut borrow occurs here}}
        s2.p = get_random_ptr(&_Mut b); // expected-error {{cannot borrow 'b' as mutable more than once at a time}}
                                       // expected-note@-1 {{first mut borrow occurs here}}
    }
    *s1.p = 20;
    *s2.p = 20;
}

_Safe void test5(void) {
    int a = 10;
    struct S s1 = { .p = nullptr };
    struct S s2 = { .p = nullptr };
    while (s1.p != nullptr && s2.p != nullptr) {
        *s1.p = 10;
        *s2.p = 10;
        s1.p = get_random_ptr(&_Mut a);
        s2.p = get_random_ptr(&_Mut a);
    }
    *s1.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
    *s2.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
}

_Safe void test6(void) {
    int a = 10;
    struct S s = { .p = get_random_ptr(&_Mut a) };
    while (s.p) {
        *s.p = 10;
        s.p = get_random_ptr(&_Mut a);
    }
    *s.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
}

_Safe void test7(void) {
    int a = 10;
    struct S s = { .p = get_random_ptr(&_Mut a) };
    while ((s.p)) {
        *s.p = 10;
        s.p = get_random_ptr(&_Mut a);
    }
    *s.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
}

_Safe void test8(void) {
    int a = 10;
    struct S s = { .p = nullptr };
    while ((s.p = get_random_ptr(&_Mut a)) != nullptr) {
        *s.p = 10;
    }
    *s.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
}

_Safe void test9(void) {
    int a = 10;
    int x = 0;
    struct S s = { .p = get_random_ptr(&_Mut a) };
    while (++x, s.p) {
        *s.p = 10;
        s.p = get_random_ptr(&_Mut a);
    }
    *s.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
}

_Safe void test10(void) {
    int a = 10;
    int x = 0;
    struct S s = { .p = get_random_ptr(&_Mut a) };
    while (++x, s.p != nullptr) {
        *s.p = 10;
        s.p = get_random_ptr(&_Mut a);
    }
    *s.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
}

_Safe void test11(void) {
    int a = 10;
    int x = 0;
    struct S s = { .p = get_random_ptr(&_Mut a) };
    while (++x, ++x, s.p) {
        *s.p = 10;
        s.p = get_random_ptr(&_Mut a);
    }
    *s.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
}

_Safe void test12(void) {
    int a = 10;
    int x = 0;
    struct S s = { .p = get_random_ptr(&_Mut a) };
    while (++x, ++x, s.p != nullptr) {
        *s.p = 10;
        s.p = get_random_ptr(&_Mut a);
    }
    *s.p = 20; // expected-error {{cannot dereference possibly-null status pointer 'p'}}
}