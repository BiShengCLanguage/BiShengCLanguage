// RUN: %clang_cc1 -nullability-check=all -verify %s

void case1() {
  union UInt {
    int x;
  };
  union UPtr {
    int *_Nonnull p;
  };
  int x = 1;
  int *p = &x;

  union UInt u1 = {};
  union UInt u2 = {x};
  union UPtr u3 = {};  // expected-error {{cannot implicitly initialize 'u3' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'u3' or declare them as '_Nullable'}}
  union UPtr u4 = {p};
}

void case2() {
  union UIn {
    int *_Nonnull p;
  };
  union UOut {
    union UIn u;
  };
  int x = 1;
  int *p = &x;

  union UOut u1 = {};  // expected-error {{cannot implicitly initialize 'u1' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'u1' or declare them as '_Nullable'}}
  union UOut u2 = {{}};  // expected-error {{cannot implicitly initialize 'u2' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'u2' or declare them as '_Nullable'}}
  union UOut u3 = {{p}};
}

void case3() {
  union UIn {
    int *_Nonnull p;
  };
  struct SOut {
    union UIn u;
  };
  int x = 1;
  int *p = &x;

  struct SOut s1 = {};  // expected-error {{cannot implicitly initialize 's1' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 's1' or declare them as '_Nullable'}}
  struct SOut s2 = {{}};  // expected-error {{cannot implicitly initialize 's2' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 's2' or declare them as '_Nullable'}}
  struct SOut s3 = {{p}};
}

void case4() {
  struct SIn {
    int *_Nonnull p;
  };
  union UOut {
    struct SIn s;
  };
  int x = 1;
  int *p = &x;

  union UOut u1 = {};  // expected-error {{cannot implicitly initialize 'u1' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'u1' or declare them as '_Nullable'}}
  union UOut u2 = {{}};  // expected-error {{cannot implicitly initialize 'u2' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'u2' or declare them as '_Nullable'}}
  union UOut u3 = {{p}};
}
