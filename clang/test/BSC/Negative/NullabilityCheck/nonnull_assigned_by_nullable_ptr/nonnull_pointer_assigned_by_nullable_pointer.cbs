// RUN: %clang_cc1 -verify %s

_Safe int *_Owned _Nonnull safe_malloc(int a);

_Safe void test1(void) {
    int *_Borrow _Nullable p1 = nullptr;
    int *_Borrow _Nonnull p2 = p1;   // expected-error {{cannot assign possibly-null status pointer 'p1' to a '_Nonnull' pointer}}
    int a = 10;
    int *_Borrow _Nullable p3 = &_Mut a;
    int *_Borrow _Nonnull p4 = p3;
    int *_Borrow _Nonnull p5 = &_Mut a;
    p5 = p1;   // expected-error {{cannot assign possibly-null status pointer 'p1' to a '_Nonnull' pointer}}
    p5 = p3;
}

_Safe void test2(void) {
    int *_Owned _Nullable p1 = nullptr;
    int *_Owned _Nonnull p2 = p1;   // expected-error {{cannot assign possibly-null status pointer 'p1' to a '_Nonnull' pointer}}
    int *_Owned _Nullable p3 = safe_malloc(5);
    int *_Owned _Nonnull p4 = p3;
    int *_Owned _Nonnull p5 = safe_malloc(5);
    p5 = p1;   // expected-error {{cannot assign possibly-null status pointer 'p1' to a '_Nonnull' pointer}}
    p5 = p3;
}

_Safe void test3(void) {
    int *_Borrow _Nullable p1 = nullptr;
    int *_Borrow p2 = p1;   // expected-error {{cannot assign possibly-null status pointer 'p1' to a '_Nonnull' pointer}}
    int a = 10;
    int *_Borrow _Nullable p3 = &_Mut a;
    int *_Borrow p4 = p3;
    int *_Borrow p5 = &_Mut a;
    p5 = p1;   // expected-error {{cannot assign possibly-null status pointer 'p1' to a '_Nonnull' pointer}}
    p5 = p3;
}

_Safe void test4(void) {
    int *_Owned _Nullable p1 = nullptr;
    int *_Owned p2 = p1;   // expected-error {{cannot assign possibly-null status pointer 'p1' to a '_Nonnull' pointer}}
    int *_Owned _Nullable p3 = safe_malloc(5);
    int *_Owned p4 = p3;
    int *_Owned p5 = safe_malloc(5);
    p5 = p1;   // expected-error {{cannot assign possibly-null status pointer 'p1' to a '_Nonnull' pointer}}
    p5 = p3;
}

_Safe void test5(void) {
    int a = 10;
    int *_Borrow _Nonnull p1 = a == 1 ? nullptr : &_Mut a; // expected-error {{cannot assign a possibly-null status pointer to a '_Nonnull' pointer}}
    int *_Borrow _Nullable p2 = a == 1 ? nullptr : &_Mut a;
    *p2 = 10;  // expected-error {{cannot dereference possibly-null status pointer 'p2'}}
    int b = 10;
    int *_Borrow _Nullable p3 = a == 1 && b == 10 ? &_Mut b : &_Mut a;
    *p3 = 10;

    p1 = a == 1 ? nullptr : &_Mut a;  // expected-error {{cannot assign a possibly-null status pointer to a '_Nonnull' pointer}}
    p2 = a == 1 ? nullptr : &_Mut a;
    *p2 = 10;  // expected-error {{cannot dereference possibly-null status pointer 'p2'}}
    p3 = a == 1 && b == 10 ? &_Mut b : &_Mut a;
    *p3 = 10;
}

_Safe void side_effect(void);

_Safe void test6(int *_Borrow _Nonnull target,
                 int *_Borrow _Nullable pointer) {
    int *_Borrow _Nullable temporary = nullptr;
    target = (side_effect(), pointer); // expected-error {{cannot assign possibly-null status pointer 'pointer' to a '_Nonnull' pointer}}
    target = (temporary = pointer); // expected-error {{cannot assign possibly-null status pointer 'pointer' to a '_Nonnull' pointer}}
}
