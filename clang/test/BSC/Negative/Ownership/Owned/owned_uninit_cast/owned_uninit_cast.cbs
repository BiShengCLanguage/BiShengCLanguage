// RUN: %clang_cc1 -verify %s

void exhaust(void *_Owned);

void basic() {
    int *_Owned uninit;
    exhaust((void *_Owned)uninit); // expected-error {{cannot cast 'uninit' to 'void * _Owned' because it is uninitialized}}
}

struct Foo {
    int x;
};

void custom() {
    struct Foo *_Owned uninit;
    exhaust((void *_Owned)uninit); // expected-error {{cannot cast 'uninit' to 'void * _Owned' because it is uninitialized}}
}

int main() {
    basic();
    custom();
    return 0;
}
