// RUN: %clang_cc1 -verify %s

struct S {
  int a;
  int *_Owned _Nullable p;
};

struct N {
  int a;
  int *_Owned _Nonnull p;
};
struct Wrapper {
  struct S s1;
  struct S s2;
};
struct T {
  int a;
  int* _Nonnull p;
};

_Safe void test(void){
  int* _Nonnull p2 = nullptr; // expected-error {{cannot assign a possibly-null status pointer to a '_Nonnull' pointer}}
  struct T t2={0}; // expected-error {{cannot implicitly initialize 't2' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 't2' or declare them as '_Nullable'}}
}

_Safe int *_Owned getptr(void);
_Safe void consume(int *_Owned);

_Safe void test_n_zero_init(void) {
  struct N n = {0}; // expected-error {{cannot implicitly initialize 'n' because it contains '_Nonnull' pointer}} expected-note {{add explicit initializer for '_Nonnull' pointers inside 'n' or declare them as '_Nullable'}}
}

_Safe void test_initializations(void) {
  struct S i_all = {1, nullptr};
  struct S i_zero = {0};         // Implicit null for p
  struct S i_empty = {};         // GNU C / C23 empty init

  struct S d_all = {.a = 1, .p = nullptr};
  struct S d_a = {.a = 1};
  struct S d_p = {.p = nullptr};

  struct Wrapper w_zero = {  // Implicit null for s1.p and s2.p
    .s1 = {0},
    .s2 = {0}
  };
  struct Wrapper w_nested = {
    .s1 = {.a = 1},
    .s2 = {2, nullptr}
  };

  i_empty.p = getptr();
  consume(i_empty.p);

  d_a.p = getptr();
  consume(d_a.p);

  w_nested.s1.p = getptr();
  consume(w_nested.s1.p);
}

_Safe void test_owned_struct_array(void) {
  struct S arr[3] = {
    {0},
    {.a = 1}
  };
  (void)arr;
}
