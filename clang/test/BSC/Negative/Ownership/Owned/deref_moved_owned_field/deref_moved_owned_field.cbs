// RUN: %clang_cc1 -fbsc-experimental -verify %s

// Regression (umbrella IJP3AP, F67): dereferencing a moved `_Owned` struct
// field (`*s.p` after `s.p` was moved out) was silently accepted. The move
// IS tracked -- reusing the moved field as a call argument is diagnosed --
// but `HandleDREUse` hands the deref site a field name carrying a trailing
// `*` marker, and `checkSFieldUse`'s moved-field membership test compared
// that marked name against the bare stored field name, so it never matched.
// Result: silent use-after-move, runtime invalid read.

_Safe T *_Owned safe_malloc<T>(T);
void safe_free(void *_Owned);
void sink(int *_Owned);
void sink_pp(int *_Owned *_Owned);

struct Inner { int *_Owned p; };
struct Outer { struct Inner inner; };
struct DoublePtr { int *_Owned *_Owned pp; };

_Owned struct OwnedInner {
_Public:
  int *_Owned p;
  ~OwnedInner(OwnedInner this) {
    safe_free((void *_Owned)this.p);
  }
};

// the move IS tracked: re-using the moved field as a call argument is caught.
void baseline_reuse_as_arg(void) {
  struct Inner s = { safe_malloc<int>(1) };
  sink(s.p);
  sink(s.p); // expected-error {{use of moved value: `s.p`}}
}

// F67: the deref READ of the moved field must be caught too.
int deref_read_after_move(void) {
  struct Inner s = { safe_malloc<int>(1) };
  sink(s.p);
  return *s.p; // expected-error {{use of moved value: `s.p`}}
}

// deref of the moved field inside a larger expression.
int deref_in_expr_after_move(void) {
  struct Inner s = { safe_malloc<int>(1) };
  sink(s.p);
  return *s.p + 1; // expected-error {{use of moved value: `s.p`}}
}

// nested field path.
int deref_nested_after_move(void) {
  struct Outer o = { { safe_malloc<int>(1) } };
  sink(o.inner.p);
  return *o.inner.p; // expected-error {{use of moved value: `o.inner.p`}}
}

// multi-level dereference: HandleDREUse accumulates one `*` marker per deref,
// so the moved field must still be resolved after stripping several of them.
int deref_multilevel_after_move(void) {
  struct DoublePtr q = { safe_malloc<int *_Owned>(safe_malloc<int>(1)) };
  sink_pp(q.pp);
  return **q.pp; // expected-error {{use of moved value: `q.pp`}}
}

// The inner owned pointer field is tracked as `pp*`; normalization must not
// strip all the way back to `pp`.
int deref_inner_field_after_move(void) {
  struct DoublePtr q = { safe_malloc<int *_Owned>(safe_malloc<int>(1)) };
  sink(*q.pp);
  int x = **q.pp; // expected-error {{use of moved value}}
  sink_pp(q.pp); // expected-error {{use of partially moved value}}
  return x;
}

// Same deref-marker mismatch through the `_Owned struct *` field path.
int deref_ops_field_after_move(OwnedInner *_Owned s) {
  sink(s->p);
  return *s->p; // expected-error {{use of moved value}}
} // expected-error {{memory leak of value: `s`}}
