// RUN: %clang_cc1 -ast-dump -verify %s


// issue I8M1X8 testcase

int a = 0;

_Owned int* Func_1<T>() // expected-error {{type of 'int' cannot be qualified by '_Owned'}}
{
    T tmp = (_Owned int*)a; // expected-error {{type of 'int' cannot be qualified by '_Owned'}} expected-warning 2 {{cast to 'int *' from smaller integer type 'int'}}
    return tmp;
}

int main()
{
    _Owned int* res = Func_1<_Owned int*>(); // expected-error 2 {{type of 'int' cannot be qualified by '_Owned'}} expected-note {{in instantiation of function template specialization 'Func_1<int *>' requested here}}

    if (*res != 0) {
        return 1;
    }
    return 0;
}
