// RUN: %clang_cc1 -fbsc-diag=exhaustive -fbsc-experimental -verify %s

typedef struct {
    int a;
    int* _Owned p;
} B;

typedef struct {
    int a;
    int* _Owned p;
    B* b;
} ownedA;

B* ownedA::getB(This* this) {
    return this->b;
}

ownedA func1(ownedA sa) {
    return sa;
}
void test1(ownedA sa) {
    int res1 = sa.a;
    func1(sa).a;    // expected-error {{the _Owned value of 'func1(sa)' is discarded and would leak}}
    int res2 = func1(sa).a; // expected-error {{the _Owned value of 'func1(sa)' is discarded and would leak}}
    return;
}


ownedA* func2(ownedA* sa) {
    return sa;
}

void test2(ownedA* sa) {
    int res1 = sa->a;
    func2(sa)->a; // expected-warning {{expression result unused}} // expected-warning {{expression result unused}}
    int res2 = func2(sa)->a;
    return;
}


void test3(ownedA sa) {
    B* res1 = func1(sa).getB(); // expected-error {{the _Owned value of 'func1(sa)' is discarded and would leak}}
    int res2 = func1(sa).getB()->a; // expected-error {{the _Owned value of 'func1(sa)' is discarded and would leak}}
    return;
}

typedef struct {
    int* p1;
    int* _Owned p2;
} CC;

CC* fun4(CC* c) { return c; }

void test4(CC* c) {
    fun4(c)->p1++;
    *fun4(c)->p2 += 1;
}
