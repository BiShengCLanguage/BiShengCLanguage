// RUN: %clang_cc1 -verify %s
// expected-no-diagnostics

T identity<T>(T t) { return t; }

int *_Owned safe_malloc(int);
void safe_free(void *_Owned);

void test() {
  int a = 0;
  int *_Owned p1 = safe_malloc(a);
  int *_Owned p2 = identity(p1);
  safe_free((void *_Owned)p2);
}

void test_local_array() {
  int *_Owned arr[2];
  for (int i = 0; i < 2; i++)
    arr[i] = safe_malloc(i);
  for (int i = 0; i < 2; i++)
    safe_free((void *_Owned)arr[i]);
}

int main() { test(); }
