// RUN: %clang_cc1 -verify %s

// A struct-value copy carries the source's must-be-null fields, so a null
// field stays null in the destination. A field that genuinely owns a value in
// the source is still owned by the destination, though: the copy duplicates
// the pointer, so the destination must free or move it.

void *malloc(unsigned long size);

struct S { int *_Owned _Nullable p; };

void copy_owned_field_leaks(void) {
  struct S a = {};
  a.p = __take_from_raw((int *)malloc(4));
  struct S b = a;
} // expected-error {{memory leak because b.p is not freed or moved before 'b' goes out of scope}}

void assign_owned_field_leaks(void) {
  struct S a = {};
  a.p = __take_from_raw((int *)malloc(4));
  struct S b = {};
  b = a;
} // expected-error {{memory leak because b.p is not freed or moved before 'b' goes out of scope}}

// Only the field that owns a value is reported: the null sibling stays null.
struct T { int *_Owned _Nullable p; int *_Owned _Nullable q; };

void partial_copy_reports_only_owned_field(void) {
  struct T a = {};
  a.p = __take_from_raw((int *)malloc(4));
  struct T b = a;
} // expected-error {{memory leak because b.p is not freed or moved before 'b' goes out of scope}}

// The field sets are unions over the paths reaching a point, so a field that
// is owned on one path and null on another (Owned|Null) still owns a live
// value: the copy duplicates that pointer and the destination must free or
// move it. Only *must*-be-null fields are mirrored onto the destination.
void copy_maybe_null_field_leaks(int c) {
  struct S a = {};
  if (c)
    a.p = __take_from_raw((int *)malloc(4));
  struct S b = a;
} // expected-error {{memory leak because b.p is not freed or moved before 'b' goes out of scope}}

// The assignment form mirrors from the source state captured before the
// assignment consumes the source, so the same holds for `b = a;`.
void assign_maybe_null_field_leaks(int c) {
  struct S a = {};
  if (c)
    a.p = __take_from_raw((int *)malloc(4));
  struct S b = {};
  b = a;
} // expected-error {{memory leak because b.p is not freed or moved before 'b' goes out of scope}}
