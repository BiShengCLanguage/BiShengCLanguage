// RUN: %clang_cc1 -verify %s

int rand(void);
void free(void *);
int *_Owned safe_malloc_int(void);

struct H { int *_Owned data; int tag; };

void maybe_uninit_field_move(void) {
    struct H h;
    h.tag = 1;
    if (rand()) {
        h.data = safe_malloc_int();
    }
    free(__move_to_raw(h.data)); // expected-error {{use of uninitialized value: 'h.data'}}
}
