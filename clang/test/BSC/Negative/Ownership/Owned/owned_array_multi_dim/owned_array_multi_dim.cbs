// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

void test_multi_dim_wrong_order() {
  int *_Owned a[2][3] = {{safe_malloc(1), safe_malloc(1), safe_malloc(1)},
                         {safe_malloc(1), safe_malloc(1), safe_malloc(1)}};
  for (int j = 0; j < 3; j++) {
    for (int i = 0; i < 2; i++) { // expected-note {{for-loop is not a qualifying for-loop: array accesses in the body must use the loop index (a[i])}}
      a[i][j] = safe_malloc(i * j); // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop}}
    }
  }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}
