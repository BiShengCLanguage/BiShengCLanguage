// RUN: %clang_cc1 -ast-dump -verify %s

typedef struct A {
    _Owned int a; // expected-error {{type of 'int' cannot be qualified by '_Owned'}}
} SA;

void test() {
    _Owned int arr1[10]; // expected-error {{type of 'int' cannot be qualified by '_Owned'}}
    _Owned int* arr3[2]; // expected-error {{type of 'int' cannot be qualified by '_Owned'}}
    SA* arr4[3];
    SA arr2[3];
    struct A arr[4];
    int *_Owned ok[2];
    return;
}

void test2() {
    int arr[3];
    int* _Owned p1 = &arr[1];    // expected-error {{incompatible _Owned types, cannot cast 'int *' to 'int *_Owned'}}
}

struct B {
    int *_Owned arr[3];
    _Owned int arr1[3];  // expected-error {{type of 'int' cannot be qualified by '_Owned'}}
};

int *_Owned global_arr[10]; // expected-error {{type of global variable cannot be qualified by '_Owned'}}
