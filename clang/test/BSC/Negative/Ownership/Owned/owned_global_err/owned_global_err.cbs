// RUN: %clang_cc1 -ast-dump -verify %s

_Owned int a = 10; //expected-error {{type of 'int' cannot be qualified by '_Owned'}}

typedef struct A {
    _Owned int num; // expected-error {{type of 'int' cannot be qualified by '_Owned'}}
}SA;

SA sa1 = {.num = 10};

struct A sa2 = {.num = 20};

typedef struct B {
    SA* sa;
}SB;

SB* sb1;


