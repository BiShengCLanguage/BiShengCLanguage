// RUN: %clang_cc1 -verify %s

void free_owned_new(void * _Owned p);

typedef struct A {
	int * _Owned a;
} A;

void test1(A * _Owned p) {
	free_owned_new((void * _Owned)p); // expected-error {{cannot cast 'p' to 'void * _Owned': p.a is still _Owned; move it out first}}
}

int * _Owned test2() {
	int * _Owned a;
	return a;        // expected-error {{use of uninitialized value: 'a'}}
}

_Safe T *_Owned safe_malloc<T>(T t);
_Safe void test3(void) {
    int *_Owned _Nullable p = nullptr;
    int cond = 1;
    if (cond) {
        p = safe_malloc<int>(10);
        *p = 10;
    }
    p = nullptr; // expected-error {{cannot assign to 'p' because it still holds an _Owned value; move or free it first}}
}
