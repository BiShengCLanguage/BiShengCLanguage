// RUN: %clang_cc1 -fbsc-experimental -ast-dump -verify %s

typedef _Owned int ownInt; // expected-error {{type of 'int' cannot be qualified by '_Owned'}}
ownInt a = 10;

typedef struct A {
    _Owned int a; // expected-error {{type of 'int' cannot be qualified by '_Owned'}}
}AA;

AA aa;

typedef _Owned struct B {
    int a;
}BB;

BB bb;  //expected-error {{type of global variable cannot be qualified by '_Owned' because 'BB' (aka '_Owned struct B') contains a '_Owned' type}}