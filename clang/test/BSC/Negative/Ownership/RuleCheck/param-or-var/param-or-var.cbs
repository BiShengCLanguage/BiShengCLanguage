// RUN: %clang_cc1 -verify %s

struct A {};

void func1(int * _Owned a) {} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func2(int * _Owned a) {
	{}
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func5(struct A * _Owned a) {} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func6(int * _Owned a) {
	int num = 5;
	a = __take_from_raw(&num); // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}}
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func7() {
	int num = 1;
	int * _Owned a;
	a = __take_from_raw(&num);
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func13(int * _Owned a) {
	int * _Owned p = a;
	int n = 0;
	a = __take_from_raw(&n);
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'p' is not freed or moved before it goes out of scope}}

void func14(int * _Owned a, int * _Owned b) {
	a = b; // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}}
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}


struct B {
	int * _Owned a;
	int * _Owned b;
};

void func15(struct B b) {
	int * _Owned a = b.a;
} // expected-error {{memory leak because b.b is not freed or moved before 'b' goes out of scope}} expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

struct B func16(struct B b) {
	int * _Owned a = b.b;
	return b; // expected-error {{use of partially moved value: 'b', b.b is moved}} expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}
}

int main() {
	return 0;
}