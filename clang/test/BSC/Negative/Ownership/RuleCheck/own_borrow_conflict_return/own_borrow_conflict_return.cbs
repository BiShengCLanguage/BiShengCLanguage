// RUN: %clang_cc1 -verify %s

int *_Owned _Borrow get_resource() { //#1
    static int resource = 42;
    return (int *_Owned _Borrow)&resource; // expected-error {{cannot cast between _Owned and raw pointer; use __move_to_raw or __take_from_raw for ownership transfer}}
    // expected-error@-1 {{cannot combine '_Owned' and '_Borrow' qualifiers on the same type}}
}

// expected-error@#1 {{cannot combine '_Owned' and '_Borrow' qualifiers on the same type}}
