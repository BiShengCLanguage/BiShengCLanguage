void func8(int num, int * _Owned argA, int * _Owned argB) {
    int * _Owned a;
    if (num > 0) {
        a = argA;
    } else {
    }
    int * _Owned b = a; // expected-error {{use of possibly uninitialized value: 'a'}}
} // expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'argA' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'argB' is not freed or moved before it goes out of scope}}

void func9(int num, int * _Owned argA, int * _Owned argB) {
    int * _Owned a;
    if (num > 0) {
        a = argA;
    }

    if (num < 10) {
        int * b = __move_to_raw(argB);
        a = argA; // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}} expected-error {{use of moved value: 'argA'}}
    }
} // expected-error {{memory leak because 'argA' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'argB' is not freed or moved before it goes out of scope}}

void func10(int * _Owned a, int * _Owned b) {
    if (1 + 1) {
        int * _Owned d = a;
    } else { // expected-error {{memory leak because 'd' is not freed or moved before it goes out of scope}}
    }
} // expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}}

void func11(int n) {
    int num = 5;
    int * _Owned a;
    if (n > 0) {
        a = __take_from_raw(&num);
        if (n > 5)
            a = __take_from_raw(&num); // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}}
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

