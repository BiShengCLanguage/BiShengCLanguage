// RUN: %clang_cc1 -verify %s

void func1(int num) {
    int b = 5;
    int * _Owned p = __take_from_raw(&b);
    int * _Owned a;
    if (num > 0) {
        a = p;
    } else {
        a = p;
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func2(int num) {
    int b = 5;
    int * _Owned p = __take_from_raw(&b);
    int * _Owned a;
    if (num > 0) {
        a = p;
    }
} // expected-error {{memory leak because 'p' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func3(int num) {
    int b = 5;
    int * _Owned p = __take_from_raw(&b);
    int * _Owned a;
    if (num > 0) {
        a = p;
    } else {}
} // expected-error {{memory leak because 'p' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func4(int num, int * _Owned a) {
    int * _Owned b;
    if (num > 0)
        b = a;
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}}

void func5(int num, int * _Owned a) {
    int n = 1;
    int * _Owned b = __take_from_raw(&n);
    if (num > 5) {
        int * _Owned c = b;
        if (num > 10) {
            b = a;
        }
    } else if (num < - 10) { // expected-error {{memory leak because 'c' is not freed or moved before it goes out of scope}}
        b = a; // expected-error {{cannot assign to 'b' because it still holds an _Owned value; move or free it first}}
    } else {
        b = a; // expected-error {{cannot assign to 'b' because it still holds an _Owned value; move or free it first}}
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}}

