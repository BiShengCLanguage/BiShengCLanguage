void twice(struct Wide w) {
  int *_Owned a = w.f299;
  int *_Owned b = w.f299; // expected-error {{use of moved value: 'w.f299'}}
  safe_free((void *_Owned)a);
  safe_free((void *_Owned)b);
} // expected-error {{memory leak because w.f0,}}
