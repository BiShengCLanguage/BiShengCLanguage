            a = b; // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}} expected-error {{use of uninitialized value: 'b'}}
        }
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

