// RUN: %clang_cc1 -verify %s

int rand();
int * _Owned assign();

void func1() {
    int * _Owned a;
    while (rand()) {
        a = assign(); // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}}
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func2() {
    int * _Owned a;
    int * _Owned b;
    while (rand()) {
        b = assign();
        a = b; // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}}
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func3() {
    int * _Owned a;
    int * _Owned b;
    int c;
    while (rand()) {
        if (c) {
            continue;
        }
        if (c) {
            continue;
        }
        b = assign();
        a = b; // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}}
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func4() {
    int * _Owned a;
    int * _Owned b;
    int c;
    if (rand()) {
        goto label1;
    }
    while (rand()) {
        if (c) {
            continue;
        }
label1:
        if (c) {
            continue;
        }
        while (rand()) {
            b = assign(); // expected-error {{cannot assign to 'b' because it still holds an _Owned value; move or free it first}}
        }
    }
} // expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}}

