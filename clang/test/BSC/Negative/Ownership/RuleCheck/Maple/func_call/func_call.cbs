// RUN: %clang_cc1 -verify %s

struct C {
    int * _Owned a;
    int * _Owned b;
};

struct B {
    int * _Owned a;
    int * _Owned b;
    struct C * _Owned c;
};

struct A {
    struct B b;
    struct B * _Owned c;
    struct B d;
    struct A * f;
};

int * _Owned IntPtrOwned() {
    int * _Owned a;
    return a; // expected-error {{use of uninitialized value: 'a'}}
}

void func1(int * _Owned * _Owned * _Owned a, int * _Owned * _Owned * _Owned b) {
    int * _Owned c = IntPtrOwned();
    int * _Owned d = c;
    int * _Owned e = c; // expected-error {{use of moved value: 'c'}}
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}} expected-error {{memory leak because *a, **a are not freed or moved before 'a' goes out of scope}} expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}} expected-error {{memory leak because *b, **b are not freed or moved before 'b' goes out of scope}} expected-error {{memory leak because 'd' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'e' is not freed or moved before it goes out of scope}}

void * _Owned VoidPtrOwned_err(struct C * _Owned c) {
    int *d = __move_to_raw(c->a);
    d = __move_to_raw(c->b);
    return (void * _Owned)c;
}

void * _Owned VoidPtrOwned_succ(struct C * _Owned c) {
    struct C d = (struct C) *c;
    return (void * _Owned)c; // expected-error {{memory leak because d.a, d.b are not freed or moved before 'd' goes out of scope}}
}

int * _Owned IntOwned() {
    int * _Owned a;
    return a; // expected-error {{use of uninitialized value: 'a'}}
}

void callee1(int * _Owned a, int * _Owned b) {} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}}

void caller1(int * _Owned a, int * _Owned b) {
    callee1(a, b);
}

void caller2(int * _Owned a, int * _Owned b) {
    int * _Owned c = a;
    callee1(a, b); // expected-error {{use of moved value: 'a'}}
} // expected-error {{memory leak because 'c' is not freed or moved before it goes out of scope}}

void callee2(void * _Owned a) {} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void caller3(void * _Owned a) {
    callee2(a);
}

void caller4(struct A * _Owned a) {
    struct A b = (struct A)*a;
    callee2((void * _Owned)a);
} // expected-error {{memory leak because b.b.a, b.b.b, b.b.c, b.b.c.a, b.b.c.b, b.c, b.c.a, b.c.b, b.c.c... are not freed or moved before 'b' goes out of scope}}

void caller5(struct A * _Owned a) {
    callee2((void * _Owned)a); // expected-error {{cannot cast 'a' to 'void * _Owned': a.b.a, a.b.b, a.b.c, a.b.c.a, a.b.c.b, a.c, a.c.a, a.c.b, a.c.c... are still _Owned; move it out first}}
}

int main() { return 0; }