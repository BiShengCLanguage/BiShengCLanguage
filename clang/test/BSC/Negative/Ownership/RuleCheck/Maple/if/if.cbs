// RUN: %clang_cc1 -verify %s

int rand();

void func1(int * _Owned argA, int * _Owned argB) {
    int * _Owned a;
    if (rand()) {
        a = argA;
    } else {
        a = argB;
    }
} // expected-error {{memory leak because 'argA' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'argB' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func2(int * _Owned argA, int * _Owned argB) {
    int * _Owned a;
    if (rand()) {
        a = argA;
    } else {
    }
    int * _Owned b = a; // expected-error {{use of possibly uninitialized value: 'a'}}
} // expected-error {{memory leak because 'argA' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'argB' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}}

void func3(int * _Owned argA, int * _Owned argB) {
    int * _Owned a;
    if (rand()) {
        a = argA;
    } else {
    }
    int * _Owned b = argA; // expected-error {{use of moved value: 'argA'}}
} // expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'argB' is not freed or moved before it goes out of scope}}

void func4(int local) {
    int * _Owned a = __take_from_raw(&local);
    int * _Owned b;
    switch (rand()) {
        case 0: {
            break;
        }
        case 1: {
            b = a;
            break;
        }
        case 4: {
            b = a;
            break;
        }
        case 5: {
            break;
        }
        default:
            break;
    }
    b = __take_from_raw(&local); // expected-error {{cannot assign to 'b' because it still holds an _Owned value; move or free it first}}
} // expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func5(int * _Owned argA, int * _Owned argB) {
    int * _Owned a;
    int * _Owned b;
    if (rand()) {
        a = argA;
        if (rand()) {
            b = a;
        }
    } else {
        b = argB;
    }
    b = a; // expected-error {{cannot assign to 'b' because it still holds an _Owned value; move or free it first}} expected-error {{use of moved value: 'a'}}
} // expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'argA' is not freed or moved before it goes out of scope}} expected-error {{memory leak because 'argB' is not freed or moved before it goes out of scope}}
