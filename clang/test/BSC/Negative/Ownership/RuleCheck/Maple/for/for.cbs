// RUN: %clang_cc1 -verify %s

int rand();
int * _Owned assign();

void func1() {
    int * _Owned a;
    for (int i = 0; i < 10; i++) {
        a = assign(); // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}}
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func2() {
    int * _Owned a;
    int * _Owned b;
    for (int i = 0; i < 10; i++) {
        b = assign();
        a = b; // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}}
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void func3() {
    int * _Owned a;
    int * _Owned b;
    int c;
    for (int i = 0; i < 10; i++) {
        if (c) {
            continue;
        }
        if (c) {
            continue;
        }
        b = assign();
        a = b; // expected-error {{cannot assign to 'a' because it still holds an _Owned value; move or free it first}}
    }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

int main() { return 0; }