// RUN: %clang_cc1 -verify %s

struct A {
    int a;
};

void eat(struct A * _Owned a) {
    struct A b = (struct A)*a;
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void f() {
    struct A a = { .a = 0 };
    if (a.a) {
        struct A * _Owned b = __take_from_raw(&a);
        if (a.a) {
            return; // expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}}
        }
        eat(b);
    }
}

int main() { return 0; }