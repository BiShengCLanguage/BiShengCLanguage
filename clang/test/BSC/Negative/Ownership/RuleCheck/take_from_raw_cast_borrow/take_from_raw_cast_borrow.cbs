// RUN: %clang_cc1 -fsyntax-only -verify %s

// `__take_from_raw` must not take ownership from a borrowed pointer, even
// when the borrow is cast to a raw pointer first.

void *malloc(unsigned long);
void free(void *);

_Unsafe int cast_borrow(void) {
  int *raw = (int *)malloc(sizeof(int));
  int *_Borrow b = &_Mut *raw;
  int *_Owned p = __take_from_raw((int *)b); // expected-error {{cannot take ownership of a borrowed value}}
  free(__move_to_raw(p));
  return *b;
}

_Unsafe int cast_borrow_array(void) {
  int *raw = (int *)malloc(4 * sizeof(int));
  int *_Borrow b = &_Mut *raw;
  int *_Owned _ArrayElem p = __take_array_from_raw((int *)b); // expected-error {{cannot take ownership of a borrowed value}}
  free(__move_array_to_raw(p));
  return 0;
}

_Unsafe int direct_borrow(void) {
  int *raw = (int *)malloc(sizeof(int));
  int *_Borrow b = &_Mut *raw;
  int *_Owned p = __take_from_raw(b); // expected-error {{argument must be a raw pointer type (have 'int *_Borrow')}}
  free(__move_to_raw(p));
  return 0;
}

_Unsafe int from_raw(void) {
  int *raw = (int *)malloc(sizeof(int));
  int *_Owned p = __take_from_raw(raw);
  free(__move_to_raw(p));
  return 0;
}
