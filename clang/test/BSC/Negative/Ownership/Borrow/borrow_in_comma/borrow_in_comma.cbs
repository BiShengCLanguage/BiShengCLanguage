// RUN: %clang_cc1 -verify %s

void use(int *_Borrow p);

// A borrow created in the comma's RHS freezes its borrowee.
void borrow_created_in_comma(void) {
  int x = 0;
  int *_Borrow m = (0, &_Mut x); // expected-warning {{left operand of comma operator has no effect}} expected-note {{'x' is borrowed here}}
  x = 99; // expected-error {{cannot assign to 'x' because it is borrowed}}
  use(m);
}

// The value of a comma expression is its RHS, so the borrow binds to the RHS
// operand. Writing the RHS borrowee is rejected; the LHS borrowee is not frozen.
void comma_value_is_rhs(void) {
  int x = 0;
  int y = 0;
  int *_Borrow m = (&_Mut x, &_Mut y); // expected-warning {{left operand of comma operator has no effect}} expected-note {{'y' is borrowed here}}
  x = 1;
  y = 99; // expected-error {{cannot assign to 'y' because it is borrowed}}
  use(m);
}

// A nested comma resolves to the innermost RHS operand.
void nested_comma(void) {
  int a = 0;
  int b = 0;
  int x = 0;
  int *_Borrow m = (a, (b, &_Mut x)); // expected-warning 2 {{left operand of comma operator has no effect}} expected-note {{'x' is borrowed here}}
  x = 99; // expected-error {{cannot assign to 'x' because it is borrowed}}
  use(m);
}

// Using a borrow inside a comma operand keeps it live, so its borrowee stays
// frozen past the comma.
void borrow_used_in_comma(void) {
  int x = 0;
  int *_Borrow m = &_Mut x; // expected-note {{'x' is borrowed here}}
  int t = (0, (*m)); // expected-warning {{left operand of comma operator has no effect}}
  x = 99; // expected-error {{cannot assign to 'x' because it is borrowed}}
  use(m);
}
