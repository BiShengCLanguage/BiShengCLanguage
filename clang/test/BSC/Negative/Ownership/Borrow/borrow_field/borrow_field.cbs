// RUN: %clang_cc1 -fbsc-experimental -ast-dump -verify %s
union U1 {
    int a;
    int *_Borrow p; // expected-error {{type of union field cannot be qualified by '_Borrow'}}
};

struct R {
    int *_Borrow p;
};
union U2 {
    struct R r;  // expected-error {{type of union field cannot be qualified by '_Borrow' (even indirectly) because 'struct R' contains a '_Borrow' type}}
    int *_Borrow p; // expected-error {{type of union field cannot be qualified by '_Borrow'}}
};

struct S {
  int num;
  int * _Owned p;
};

int * _Owned foo(int * _Owned a) {
    return a;
}
int * _Owned foo1() {
    struct S s;
    const struct S * _Borrow p1 = &_Const s;
    return p1->p;                // expected-error {{cannot take ownership of a borrowed value}}
}

int * _Owned foo2(){
  int a = 0;
  struct S s = {0, __take_from_raw(&a)};
  struct S * _Owned b = __take_from_raw(&s);
  struct S * _Borrow p1 = &_Mut *b;
  int k = p1->num;
  int * _Owned l = p1->p;         // expected-error {{cannot take ownership of a borrowed value}}
  return p1->p;                  // expected-error {{cannot take ownership of a borrowed value}}
}

void struct S::f1(const This * _Borrow this) {}
void struct S::f2(This * _Borrow this) {}
void test() {
  struct S s;
  struct S * _Borrow p1 = &_Mut s;
  const struct S * _Borrow p2 = &_Const s;// expected-note {{variable 'p2' declared const here}} // expected-note {{variable 'p2' declared const here}}
  p2->num = 1; // expected-error {{cannot assign to variable 'p2' with const-qualified type 'const struct S *_Borrow'}}
  int a = p2->num; // legal
  a = p2->num; // legal

  p2->p = __take_from_raw(&a); // expected-error {{cannot assign to variable 'p2' with const-qualified type 'const struct S *_Borrow'}}
  int * _Owned b = p2->p; // expected-error {{cannot take ownership of a borrowed value}}
  b = p2->p; // expected-error {{cannot take ownership of a borrowed value}}

  p1->num = 1; // legal
  a = p1->num; // legal

  p1->p = __take_from_raw(&a); // legal
  b = p1->p; // expected-error {{cannot take ownership of a borrowed value}}

  foo(p1->p); // expected-error {{the _Owned value of 'foo(p1->p)' is discarded and would leak}}
              // expected-error@-1 {{cannot take ownership of a borrowed value}}
  p2->f1(); // legal
  p2->f2(); // expected-error {{incompatible conversion from const type 'const struct S *_Borrow' to non-const type 'struct S *_Borrow' in member function call}}
  p1->f1(); // legal
  p1->f2(); // legal
}