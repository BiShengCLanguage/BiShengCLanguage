// RUN: %clang_cc1 -verify %s

void deref_q_while_p_alive_in_body(void) {
  int a = 0;
  int * _Borrow _Nullable p = nullptr;
  int * _Borrow _Nullable q = nullptr;
  q = &_Mut a;
  p = q; // expected-note {{'*q' is borrowed here}}
  if (p || q) {
    *q = 1; // expected-error {{cannot assign to '*q' because it is borrowed}}
    *p = 2;
  }
}

void deref_q_while_p_alive_in_condition(void) {
  int a = 0;
  int * _Borrow _Nullable p = nullptr;
  int * _Borrow _Nullable q = nullptr;
  int * _Borrow _Nullable r = nullptr;
  q = &_Mut a;
  p = q; // expected-note {{'*q' is borrowed here}} expected-note {{first mut borrow occurs here}}
  if (p || (r = q, p)) { // expected-error {{cannot use 'q' because it was mutably borrowed}}
    // expected-error@-1 {{cannot borrow '*q' as mutable more than once at a time}}
  }
}

void deref_q_while_p_alive_after_if(void) {
  int a = 0;
  int * _Borrow _Nullable p = nullptr;
  int * _Borrow _Nullable q = nullptr;
  q = &_Mut a;
  p = q; // expected-note {{'*q' is borrowed here}}
  if (p && q) {
    *q = 1; // expected-error {{cannot assign to '*q' because it is borrowed}}
    *p = 2;
  }
  *p = 3;
}
