// RUN: %clang_cc1 -verify %s

void test1() {
  int a = 1;
  int *_Borrow p = &_Mut a;
  a = *p;
}

void test2() {
  int a = 1;
  int *_Borrow p[] = { &_Mut a };
  a = *p[0];
}

void test3() {
  int a = 1;
  int b = 2;
  int *_Borrow p[] = { &_Mut a, &_Mut b }; // expected-note {{'b' is borrowed here}}
  b = 2; // expected-error {{cannot assign to 'b' because it is borrowed}}
  a = *p[0];
}