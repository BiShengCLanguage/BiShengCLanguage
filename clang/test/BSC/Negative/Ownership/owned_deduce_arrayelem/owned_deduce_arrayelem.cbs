// RUN: %clang_cc1 -fsyntax-only -fbsc-experimental -verify %s

// `_Owned T` cannot spell an _ArrayElem argument, and `T *_ArrayElem` without
// a Kind is not a type, so deduction fails instead of minting one.
void take_owned<T>(_Owned T a);  // expected-note {{candidate template ignored: could not match '_Owned T' against 'int *_Owned _ArrayElem'}}

void bad(int *_Owned _ArrayElem p) {
  take_owned(p); // expected-error {{no matching function for call to 'take_owned'}}
}

// A _Borrow argument may downgrade to plain _Borrow at the call (manual
// 3.3.1.3), so T deduces as the plain pointer.
void take_borrow<T>(_Borrow T a);

void ok(int *_Borrow _ArrayElem p) {
  take_borrow(p);
}

// A pointer's Kind is known even under a template, so `T *_ArrayElem` is
// rejected at the definition rather than at instantiation.
void elem<T>(T *_ArrayElem p); // expected-error {{'_ArrayElem' must be combined with '_Owned' or '_Borrow' to qualify a pointer type}}
