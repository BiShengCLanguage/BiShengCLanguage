// RUN: %clang_cc1 -fsyntax-only -verify %s

struct WithBorrow {
  int *_Borrow p;
};
struct WithBorrowArrayElem {
  int *_Borrow _ArrayElem p;
};

struct WithOwned {
  int *_Owned p;
};
struct WithOwnedArrayElem {
  int *_Owned _ArrayElem p;
};

void foo(void) {
  int _ArrayElem scalar; // expected-error {{type of 'int' cannot be qualified by '_ArrayElem'}}
  int *_ArrayElem raw_ptr; // expected-error {{'_ArrayElem' must be combined with '_Owned' or '_Borrow' to qualify a pointer type}}

  struct WithBorrow *_Borrow _ArrayElem bp1;
  struct WithBorrow *_Owned _ArrayElem bp2;
  struct WithBorrowArrayElem *_Borrow _ArrayElem bp3;
  struct WithBorrowArrayElem *_Owned _ArrayElem bp4;
  struct WithOwned *_Borrow _ArrayElem dp1;
  struct WithOwned *_Owned _ArrayElem dp2;
  struct WithOwnedArrayElem *_Borrow _ArrayElem dp3;
  struct WithOwnedArrayElem *_Owned _ArrayElem dp4;
}
