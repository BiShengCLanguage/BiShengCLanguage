// RUN: %clang_cc1 -verify %s

// Test __forget dataflow: after the call the pointer is treated as moved
// (ownership forgotten), so using it without reassignment is a use-of-moved
// error. These cases contain NO Sema errors (a Sema error suppresses BSC
// CFG analyses), so the __forget calls here are all in legal _Unsafe
// contexts.

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free<T>(T *_Owned p) { free(__move_to_raw(p)); }

// After __forget on an owned pointer, reading it without reassignment is a
// use-of-moved error. (Non-_Safe function so the safe-zone raw-deref ban
// does not shadow the ownership diagnostic.)
void test_use_after_forget(void) {
  int *_Owned p = safe_malloc(1);
  _Unsafe { __forget(p); }
  *p = 1; // expected-error {{use of moved value: 'p'}}
}

// After __forget, passing p to a callee that consumes ownership is a
// use-of-moved error.
void sink(int *_Owned p);
void test_pass_after_forget(void) {
  int *_Owned p = safe_malloc(2);
  _Unsafe { __forget(p); }
  sink(p); // expected-error {{use of moved value: 'p'}}
}

// After __forget on a struct owned field, using the field is a
// use-of-moved error. (Passing the field as an argument — not dereferencing
// it — so this does not depend on the known pre-existing deref-marker
// regression in checkSFieldUse's moved-field test, which requires
// -fbsc-experimental.)
struct S { int *_Owned p; };

void sink_field(int *_Owned p);
void test_use_field_after_forget(void) {
  struct S s = {};
  s.p = safe_malloc(3);
  _Unsafe { __forget(s.p); }
  sink_field(s.p); // expected-error {{use of moved value: 's.p'}}
}

// The same through an _Owned struct pointer: `__forget(s->p)` and the
// equivalent `(*s).p` form must both drop the field's ownership. The struct
// pointer itself is also forgotten afterwards (its fields are gone either
// way), so the field-level diagnostic is not shadowed by a leak diagnostic
// for `s`.
struct Inner { int *_Owned p; };
struct Inner *_Owned make_inner(void);

void test_use_arrow_field_after_forget(void) {
  struct Inner *_Owned s = make_inner();
  _Unsafe { __forget(s->p); }
  sink_field(s->p); // expected-error {{use of moved value: 's.p'}}
  _Unsafe { __forget(s); }
}

void test_use_deref_field_after_forget(void) {
  struct Inner *_Owned s = make_inner();
  _Unsafe { __forget((*s).p); }
  sink_field((*s).p); // expected-error {{use of moved value: 's.p'}}
  _Unsafe { __forget(s); }
}

// After __forget, freeing p is a use-of-moved error (double-free path):
// ownership was already forgotten, so safe_free sees a moved value.
void test_free_after_forget(void) {
  int *_Owned p = safe_malloc(4);
  _Unsafe { __forget(p); }
  safe_free(p); // expected-error {{use of moved value: 'p'}}
}

// __forget on a struct-value variable forgets every owned field: using any
// field afterwards is a use-of-moved error.
struct Two {
  int *_Owned p;
  int *_Owned q;
};

void test_use_field_after_forget_struct_var(void) {
  struct Two t = {};
  t.p = safe_malloc(1);
  t.q = safe_malloc(2);
  _Unsafe { __forget(t); }
  sink_field(t.p); // expected-error {{use of moved value: 't.p'}}
}

// __forget(*s) on an owned struct pointer forgets every owned field of the
// pointee: using a field afterwards is a use-of-moved error. The struct
// pointer itself still owns the struct allocation, so no leak is reported for
// s after it is freed at the end.
struct Inner2 {
  int *_Owned p;
};

struct Inner2 *_Owned make_inner2(void);

void test_use_field_after_forget_deref(void) {
  struct Inner2 *_Owned s = make_inner2();
  _Unsafe { __forget(*s); }
  sink_field(s->p); // expected-error {{use of moved value: 's.p'}}
  safe_free((void *_Owned)s);
}

// __forget(t.in) on a struct-typed field forgets every owned field nested
// under it; a sibling field is unaffected.
struct In3 {
  int *_Owned p;
};

struct Outer3 {
  struct In3 in;
  int *_Owned q;
};

void test_use_field_after_forget_substruct(void) {
  struct Outer3 t = {};
  t.in.p = safe_malloc(1);
  t.q = safe_malloc(2);
  _Unsafe { __forget(t.in); }
  sink_field(t.in.p); // expected-error {{use of moved value: 't.in.p'}}
  safe_free(t.q);
}

// __forget(arr[i]) on an owned-pointer array, inside a qualifying for-loop
// (the only place an element may be forgotten, like any other element
// transfer): the array is one aggregate with no per-element state, so the
// whole aggregate is treated as moved — a later element transfer is a
// use-of-moved.
void test_use_after_forget_array_elem(void) {
  int *_Owned arr[2] = {safe_malloc(1), safe_malloc(2)};
  _Unsafe {
    for (int i = 0; i < 2; i++)
      __forget(arr[i]);
  }
  *arr[0] = 1; // expected-error {{use of moved value: 'arr'}}
}

// __forget(w.arr[i]) on an array field of a struct value, inside a
// qualifying for-loop: same aggregate semantics for the field.
struct WithArr2 {
  int *_Owned arr[2];
};

void test_use_after_forget_struct_array_field(void) {
  struct WithArr2 w = {};
  for (int i = 0; i < 2; i++)
    w.arr[i] = safe_malloc(i);
  _Unsafe {
    for (int i = 0; i < 2; i++)
      __forget(w.arr[i]);
  }
  *w.arr[0] = 1; // expected-error {{use of moved value: 'w'}}
}

// __forget(a[i].p) on a member of a struct-array element, inside a
// qualifying for-loop: same aggregate semantics for the element's field.
struct Elem2 {
  int *_Owned p;
};

void test_use_after_forget_array_elem_field(void) {
  struct Elem2 a[2] = {};
  for (int i = 0; i < 2; i++)
    a[i].p = safe_malloc(i);
  _Unsafe {
    for (int i = 0; i < 2; i++)
      __forget(a[i].p);
  }
  int v = *a[0].p; // expected-error {{use of moved value: 'a'}}
  (void)v;
}

// Forgetting an element OUTSIDE a qualifying for-loop is forbidden, exactly
// like safe_free on an element: the site is not a qualifying element
// transfer, and the aggregate must not silently move — it still owns, so a
// leak is also reported at scope end.
void test_forget_array_elem_outside_loop(void) {
  int *_Owned arr[2] = {safe_malloc(1), safe_malloc(2)};
  _Unsafe { __forget(arr[0]); } // expected-error {{cannot transfer ownership of array element `arr` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
} // expected-error {{memory leak because 'arr' is not freed or moved before it goes out of scope}}

// The same for an array field of a struct value (w.arr[0]).
void test_forget_struct_array_field_outside_loop(void) {
  struct WithArr2 w = {};
  for (int i = 0; i < 2; i++)
    w.arr[i] = safe_malloc(i);
  _Unsafe { __forget(w.arr[0]); } // expected-error {{cannot transfer ownership of array element `w` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
} // expected-error {{memory leak because w.arr[] is not freed or moved before 'w' goes out of scope}}

// And for a member of a struct-array element (a[0].p).
void test_forget_array_elem_field_outside_loop(void) {
  struct Elem2 a[2] = {};
  for (int i = 0; i < 2; i++)
    a[i].p = safe_malloc(i);
  _Unsafe { __forget(a[0].p); } // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
} // expected-error {{memory leak because a.p is not freed or moved before 'a' goes out of scope}}

// __forget(*h->sp) on an owned struct-pointer field forgets the pointee's
// owned fields: using one afterwards is a use-of-moved error. The field and
// the host still own their allocations, so the host is forgotten afterwards
// (its fields are gone either way) and no leak is reported.
struct Holder2 {
  struct Inner2 *_Owned sp;
};

struct Holder2 *_Owned make_holder2(void);

void test_use_field_after_forget_deref_field(void) {
  struct Holder2 *_Owned h = make_holder2();
  _Unsafe { __forget(*h->sp); }
  sink_field(h->sp->p); // expected-error {{use of moved value: 'h.sp.p'}}
  _Unsafe { __forget(h); }
}

// The same through a struct-value host: __forget(*t.sp) then using the
// pointee's field is a use-of-moved error; the field itself still owns the
// pointee allocation, so it is freed afterwards.
void test_use_field_after_forget_deref_field_value(void) {
  struct Holder2 t = { make_inner2() };
  _Unsafe { __forget(*t.sp); }
  sink_field(t.sp->p); // expected-error {{use of moved value: 't.sp.p'}}
  safe_free((void *_Owned)t.sp);
}

// The parenthesized spelling __forget(*(s)) resolves like __forget(*s):
// using a pointee field afterwards is a use-of-moved error.
void test_use_after_forget_deref_paren(void) {
  struct Inner2 *_Owned s = make_inner2();
  _Unsafe { __forget(*(s)); }
  sink_field(s->p); // expected-error {{use of moved value: 's.p'}}
  safe_free((void *_Owned)s);
}
