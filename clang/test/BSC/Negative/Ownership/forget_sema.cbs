// RUN: %clang_cc1 -verify %s

// Test __forget Sema rejection: safe-zone ban and non-owned argument.
// (Dataflow-after-forget cases live in forget_use.cbs — kept separate
//  because a Sema error suppresses BSC CFG analyses, see
//  SemaDecl.cpp areAllErrorsFromBSCAnalyses.)

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

// Rule 1: __forget is forbidden in a safe zone.
_Safe void test_forbidden_in_safe_zone(void) {
  int *_Owned _Nullable p = nullptr;
  __forget(p); // expected-error {{__forget is forbidden in the safe zone}}
}

// Rule 1 variant: inside a _Safe function, even within an expression the
// safe-zone context forbids the call.
_Safe void test_forbidden_in_safe_zone_expr(void) {
  int *_Owned _Nullable p = nullptr;
  (void)__forget(p); // expected-error {{__forget is forbidden in the safe zone}}
}

// Rule 1 exception: unevaluated contexts never run the call, so the ban is
// relaxed there (IsInEvaluatedSafeZone), matching __assume_null.
_Safe unsigned long test_sizeof_in_safe_zone(void) {
  int *_Owned _Nullable p = nullptr;
  return sizeof(__forget(p));
}

_Safe void test_typeof_in_safe_zone(void) {
  int *_Owned _Nullable p = nullptr;
  // __forget returns void; take the address-of-void pointer form so the
  // typeof declaration is itself valid.
  __typeof__(__forget(p)) *x = 0;
  (void)x;
}

// Rule 2: argument must be an _Owned pointer, or a struct containing _Owned
// fields. A _Nonnull (non-owned) pointer is rejected.
_Safe int *_Nonnull get_nonnull(void);
void test_non_owned_arg(void) {
  int *_Nonnull p = get_nonnull();
  _Unsafe { __forget(p); } // expected-error {{__forget requires an _Owned pointer or a struct containing ownership}}
}

// Rule 2 variant: non-pointer argument is rejected.
void test_non_pointer_arg(void) {
  int x = 0;
  _Unsafe { __forget(x); } // expected-error {{__forget requires an _Owned pointer or a struct containing ownership}}
}

// Rule 2 variant: a _Borrow pointer is not _Owned.
void test_borrow_arg(int *_Borrow p) {
  _Unsafe { __forget(p); } // expected-error {{__forget requires an _Owned pointer or a struct containing ownership}}
}

// Rule 2 variant: a raw (unqualified) pointer is not _Owned.
void test_raw_ptr_arg(int *p) {
  _Unsafe { __forget(p); } // expected-error {{__forget requires an _Owned pointer or a struct containing ownership}}
}

// Rule 2 variant: a struct without _Owned fields is rejected.
struct Plain { int x; };
void test_plain_struct_arg(void) {
  struct Plain t = {0};
  _Unsafe { __forget(t); } // expected-error {{__forget requires an _Owned pointer or a struct containing ownership}}
}

// Argument-shape: only a trackable expression is accepted — a variable, a
// struct field access, an array element, or a dereference, optionally
// chained. Any other compound expression is rejected because __forget is a
// pure analyzer hint (codegen emits nothing) and the dataflow only tracks
// per-location ownership; a compound expression would be silently dropped.

// Comma expression: must not be mis-lowered to the left operand.
void test_comma_arg(int *_Owned a, int *_Owned p) {
  _Unsafe { __forget((a, p)); } // expected-error {{__forget requires a trackable expression as argument}} expected-warning {{left operand of comma operator has no effect}}
}

// Ternary expression.
void test_ternary_arg(int c, int *_Owned p, int *_Owned q) {
  _Unsafe { __forget(c ? p : q); } // expected-error {{__forget requires a trackable expression as argument}}
}

// Explicit cast.
void test_cast_arg(int *_Owned p) {
  _Unsafe { __forget((int *_Owned)p); } // expected-error {{__forget requires a trackable expression as argument}}
}

// Forgetting a struct field through a _Borrow path would drop the ownership
// of a value the borrower does not own (and let the real owner leak), so it
// is rejected like any other ownership move through a borrow.
struct W { int *_Owned p; };

void test_forget_borrow_field(struct W *_Borrow w) {
  _Unsafe { __forget(w->p); } // expected-error {{cannot take ownership of a borrowed value}}
}

// Same through the deref-paren form.
void test_forget_borrow_field_deref(struct W *_Borrow w) {
  _Unsafe { __forget((*w).p); } // expected-error {{cannot take ownership of a borrowed value}}
}

// Same through a const borrow.
void test_forget_const_borrow_field(struct W *_Borrow w) {
  const struct W *_Borrow cw = w;
  _Unsafe { __forget(cw->p); } // expected-error {{cannot take ownership of a borrowed value}}
}

// A hop through an intermediate pointer field keeps tracking back to the
// borrow root: the field dp is an owned pointer, and the forgotten field q
// lives in its pointee struct.
struct DeepF { int *_Owned q; };
struct MidF { struct DeepF *_Owned _Nullable dp; };
void test_forget_borrow_through_ptr_field(struct MidF *_Borrow w) {
  _Unsafe { __forget(w->dp->q); } // expected-error {{cannot take ownership of a borrowed value}}
}

// A raw pointer field hop is not tracked: the dereferenced raw pointer gives
// untracked access to the pointee, so the analyzer stops there (matching
// IsBorrowRoot's raw-pointer policy) and the call is accepted.
struct MidR { struct DeepF *d; };
void test_forget_borrow_through_raw_ptr_field(struct MidR *_Borrow w) {
  _Unsafe { __forget(w->d->q); }
}

// An array-element access through a borrow root: the subscript is lowered to
// an Index place so the borrow chain is still tracked.
struct WithArr { int *_Owned arr[2]; };
void test_forget_borrow_array_elem(struct WithArr *_Borrow w) {
  _Unsafe { __forget(w->arr[0]); } // expected-error {{cannot take ownership of a borrowed value}}
}

// A deref of a borrow root: the Deref place keeps the borrow chain.
void test_forget_borrow_deref(int *_Owned *_Borrow q) {
  _Unsafe { __forget(*q); } // expected-error {{cannot take ownership of a borrowed value}}
}
