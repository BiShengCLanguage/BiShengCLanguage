// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

// The empty-else allowance must not hide an else branch that really transfers
// the element: the paths still diverge and the re-allocated element leaks.
void test_else_reassigns(void) {
  int *_Owned a[3] = {safe_malloc(1), safe_malloc(2), safe_malloc(3)};
  for (int i = 0; i < 3; i++) {
    if (a[i] != nullptr) {
      safe_free((void *_Owned)a[i]);
    } else {
      a[i] = safe_malloc(i);
    }
  } // expected-error {{ownership state of array element `a` is inconsistent across paths in for-loop body}}
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}
