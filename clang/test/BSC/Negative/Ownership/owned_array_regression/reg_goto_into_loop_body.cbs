// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) { free(__move_to_raw(p)); }

// Manual rule 4 allows a goto whose target label is inside the loop body, but
// the one-visit model assumes the body is entered only through the header: a
// jump in from *outside* runs the body with the pre-loop state, so the loop
// exit state (and the leak check that rests on it) is a lie. Here the jump
// enters at i==1 and a[0] is never freed.
void goto_into_body(void) {
  int *_Owned a[3] = {safe_malloc(1), safe_malloc(2), safe_malloc(3)};
  int i = 1;
  goto inside;
  // expected-note@+1 {{for-loop is not a qualifying for-loop: loop body must not break, return or goto out of the loop}}
  for (i = 0; i < 3; i++) {
  inside:
    safe_free((void *_Owned)a[i]); // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
  }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}
