// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) { free(__move_to_raw(p)); }

// Manual 3.3.3.1 cond 3: the loop variable must not be modified, address-taken
// or mutably borrowed. The in-body scan matches it through bare DeclRefExprs,
// so an alias taken *before* the loop and written inside the body advances the
// counter with no `i` in the scanned region: at i==0 the write jumps to 2 and
// a[1] is never freed, yet the loop was certified as qualifying and the element
// transfer allowed. The loop-variable guard must be function-wide, like the
// sibling VLA-bound-variable guard.
void loop_var_alias(void) {
  int *_Owned a[3] = {safe_malloc(1), safe_malloc(2), safe_malloc(3)};
  int i = 0;
  int *pi = &i; // expected-note {{loop variable must not be modified or have its address taken outside the increment}}
  for (i = 0; i < 3; i++) {
    if (i == 0) {
      *pi = 2;
    }
    safe_free((void *_Owned)a[i]); // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
  }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}
