// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

int *_Owned foo2(int *_Owned);
void bar(int, int *_Owned);

void test_move_then_read_in_next_statement() {
  int *_Owned a[2] = {safe_malloc(1), safe_malloc(2)};
  for (int i = 0; i < 2; i++) {
    bar(*a[i], foo2(a[i]));
    bar(*a[i], 0); // expected-error {{use of moved value: 'a'}}
  }
}
