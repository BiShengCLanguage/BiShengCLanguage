// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void consume(int *_Owned _Nullable);

// Qualifying is per-array: the same loop may cover a[3] but not b[5].
void test_mixed_lengths() {
  int *_Owned _Nullable a[3] = {safe_malloc(1), safe_malloc(2), safe_malloc(3)};
  int *_Owned _Nullable b[5] = {safe_malloc(1), safe_malloc(2), safe_malloc(3), safe_malloc(4), safe_malloc(5)};
  for (int i = 0; i < 3; i++) { // expected-note {{for-loop is not a qualifying for-loop: loop bound must equal the array length}}
    consume(a[i]);
    consume(b[i]); // expected-error {{cannot transfer ownership of array element `b` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
  }
} // expected-error {{memory leak because 'b' is not freed or moved before it goes out of scope}}

// A non-loop-index access (a[k]) is a per-array rejection too.
void test_index_mismatch(int k) {
  int *_Owned _Nullable a[3] = {safe_malloc(1), safe_malloc(2), safe_malloc(3)};
  for (int i = 0; i < 3; i++) { // expected-note {{for-loop is not a qualifying for-loop: array accesses in the body must use the loop index (a[i])}}
    consume(a[k]); // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
  }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}
