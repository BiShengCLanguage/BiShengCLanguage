// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

void use_mut(int *_Owned _Nullable *_Borrow);

struct GW {
  int *_Owned arr[2];
};

void test_field_borrow_after_free() {
  struct GW w;
  for (int i = 0; i < 2; i++)
    w.arr[i] = safe_malloc(1);
  for (int i = 0; i < 2; i++)
    safe_free((void *_Owned)w.arr[i]);
  use_mut(&_Mut w.arr[0]); // expected-error {{use of moved value: 'w'}}
}
