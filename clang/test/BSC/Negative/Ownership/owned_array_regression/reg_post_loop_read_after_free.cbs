// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

struct S { int *_Owned _Nullable p; };

// Reading an owned array element's field after a qualifying loop has moved
// every element out must be diagnosed as use-after-move.
_Safe int foo(void) {
  _Unsafe {
    struct S a[2];
    int i;
    for (i = 0; i < 2; i++) a[i].p = (int *_Owned)safe_malloc<int>(1);
    for (i = 0; i < 2; i++) safe_free((void *_Owned)a[i].p);
    *(a[0].p) = 99; // expected-error {{use of moved value: 'a'}}
    return 0;
  }
}
