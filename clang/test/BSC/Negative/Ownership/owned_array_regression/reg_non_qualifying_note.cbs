// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void consume(int *_Owned _Nullable);

// A rejected transfer in a non-qualifying loop gets a note with the rule.
void test_init_nonzero() {
  int *_Owned _Nullable a[10] = {safe_malloc(1), safe_malloc(2), safe_malloc(3), safe_malloc(4), safe_malloc(5), safe_malloc(6), safe_malloc(7), safe_malloc(8), safe_malloc(9), safe_malloc(10)};
  for (int i = 1; i < 10; ++i) { // expected-note {{for-loop is not a qualifying for-loop: loop variable must be initialized to zero (`T i = 0`)}}
    consume(a[i]);               // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
  }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void test_incr_not_by_one() {
  int *_Owned _Nullable a[10] = {safe_malloc(1), safe_malloc(2), safe_malloc(3), safe_malloc(4), safe_malloc(5), safe_malloc(6), safe_malloc(7), safe_malloc(8), safe_malloc(9), safe_malloc(10)};
  for (int i = 0; i < 10; i += 2) { // expected-note {{for-loop is not a qualifying for-loop: increment must be step one (`i++` / `++i` / `i += 1`)}}
    consume(a[i]);                  // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
  }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}

void test_bound_mismatch() {
  int *_Owned _Nullable a[10] = {safe_malloc(1), safe_malloc(2), safe_malloc(3), safe_malloc(4), safe_malloc(5), safe_malloc(6), safe_malloc(7), safe_malloc(8), safe_malloc(9), safe_malloc(10)};
  for (int i = 0; i < 5; ++i) { // expected-note {{for-loop is not a qualifying for-loop: loop bound must equal the array length}}
    consume(a[i]);              // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
  }
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}
