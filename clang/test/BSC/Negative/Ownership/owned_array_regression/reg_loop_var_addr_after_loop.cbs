// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) { free(__move_to_raw(p)); }

// Manual 3.3.3.1 cond 3: the loop variable must not have its address taken
// anywhere in its lifetime, so an alias created *after* the loop still makes
// the loop non-qualifying -- the address of the loop variable was taken. The
// element transfer is rejected and the array leaks. The guard therefore scans
// the whole function, like the sibling VLA-bound guard.
void post_loop_addr_of_counter(void) {
  int *_Owned a[2] = {safe_malloc(1), safe_malloc(2)};
  int i;
  for (i = 0; i < 2; i++) {
    safe_free((void *_Owned)a[i]); // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
  }
  int *pi = &i; // expected-note {{for-loop is not a qualifying for-loop: loop variable must not be modified or have its address taken outside the increment}}
  (void)pi;
} // expected-error {{memory leak because 'a' is not freed or moved before it goes out of scope}}
