// RUN: %clang_cc1 -verify %s

void safe_free(void *_Owned p);
int *_Owned make_ptr(void);

// A conditional release inside a qualifying for-loop leaves the element at
// Owned|Moved at the join (released on one path, still owned on the other).
// The assign-over-owned gate must use the may-own test, not the exact
// is(Owned) bit: the superposition would otherwise defeat it and the still
// owned element would be silently overwritten (a memory leak at run time).
// The scalar twin rejects the identical shape.
void f(void) {
  int *_Owned a[2] = {make_ptr(), make_ptr()};
  for (int i = 0; i < 2; ++i) {
    if (i == 0)
      safe_free((void *_Owned)a[i]);
    a[i] = make_ptr(); // expected-error {{cannot assign to 'a[]' because it still holds an _Owned value; move or free it first}}
  }
  for (int j = 0; j < 2; ++j)
    safe_free((void *_Owned)a[j]);
}
