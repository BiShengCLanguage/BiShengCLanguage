// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

struct S { int *_Owned p; };

// Reading an owned array element's field after moving it out in the same
// qualifying loop must be diagnosed as use-after-move.
int main(void) {
  struct S arr[2];
  for (int i = 0; i < 2; i++) {
    arr[i].p = (int *_Owned)safe_malloc<int>(1);
  }
  for (int i = 0; i < 2; i++) {
    safe_free((void *_Owned)arr[i].p);
    int v = *arr[i].p; // expected-error {{use of moved value: 'arr'}}
    (void)v;
  }
  return 0;
}
