// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

void test_inner_init_nonzero() {
  int *_Owned a[2][3];
  for (int i = 0; i < 2; i++) {
    for (int j = 1; j < 3; j++) { // inner loop starts at 1
      // expected-note@-1 {{for-loop is not a qualifying for-loop: loop variable must be initialized to zero (`T i = 0`)}}
      a[i][j] = safe_malloc(i * j); // expected-error {{cannot transfer ownership of array element `a` outside a qualifying for-loop}}
    }
  }
}
