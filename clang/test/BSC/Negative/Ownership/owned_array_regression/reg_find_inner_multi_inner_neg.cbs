// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

void consume(int *_Owned _Nullable);

void test_use_after_move() {
  int *_Owned arr[2][2] = {{safe_malloc(1), safe_malloc(2)},
                           {safe_malloc(3), safe_malloc(4)}};
  for (int i = 0; i < 2; i++) {
    for (int k = 0; k < 1; k++) {}
    for (int j = 0; j < 2; j++)
      safe_free((void *_Owned)arr[i][j]);
  }
  for (int i = 0; i < 2; i++) {
    for (int k = 0; k < 1; k++) {}
    for (int j = 0; j < 2; j++)
      consume(arr[i][j]); // expected-error {{use of moved value: 'arr'}}
  }
}

void test_inner_bound_mismatch() {
  int *_Owned arr[2][2] = {{safe_malloc(1), safe_malloc(2)},
                           {safe_malloc(3), safe_malloc(4)}};
  for (int i = 0; i < 2; i++) {
    for (int k = 0; k < 1; k++) {}
    for (int j = 0; j < 3; j++) // expected-note {{for-loop is not a qualifying for-loop: array accesses in the body must use the loop index (a[i])}}
      safe_free((void *_Owned)arr[i][j]); // expected-error {{cannot transfer ownership of array element `arr` outside a qualifying for-loop; use a full-range for-loop or safe_swap}}
  }
} // expected-error {{memory leak because 'arr' is not freed or moved before it goes out of scope}}
