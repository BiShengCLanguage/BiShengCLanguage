// RUN: %clang_cc1 -verify %s

void *malloc(unsigned long size);
void free(void *ptr);

T *_Owned safe_malloc<T>(T value) {
  T *p = (T *)malloc(sizeof(T));
  *p = value;
  return __take_from_raw(p);
}

void safe_free(void *_Owned p) {
  free(__move_to_raw(p));
}

// BOP host: a[i] is owned (initializer) -> a[i] = nullptr discards it.
void test_bop() {
  int *_Owned a[2] = {safe_malloc(1), safe_malloc(2)};
  for (int i = 0; i < 2; i++)
    a[i] = nullptr; // expected-error {{cannot assign to 'a[]' because it still holds an _Owned value; move or free it first}}
}

// S host, plain field: s[i].p is owned -> s[i].p = nullptr discards it.
struct T { int *_Owned p; };
void test_s_field() {
  struct T s[2] = {{safe_malloc(1)}, {safe_malloc(2)}};
  for (int i = 0; i < 2; i++)
    s[i].p = nullptr; // expected-error {{cannot assign to 'p' because it still holds an _Owned value; move or free it first}}
}

// S host, field array: s[i].arr[j] is owned -> = nullptr discards it.
struct S { int *_Owned arr[2]; };
void test_s_field_arr() {
  struct S s[2] = {{safe_malloc(1), safe_malloc(2)}, {safe_malloc(3), safe_malloc(4)}};
  for (int i = 0; i < 2; i++)
    for (int j = 0; j < 2; j++)
      s[i].arr[j] = nullptr; // expected-error {{cannot assign to 'arr[]' because it still holds an _Owned value; move or free it first}}
}

// OPS host: p->arr[i] is owned -> = nullptr discards it (p itself then leaks).
void test_ops() {
  struct S *_Owned p = __take_from_raw((struct S *)malloc(sizeof(struct S)));
  for (int i = 0; i < 2; i++)
    p->arr[i] = nullptr; // expected-error {{cannot assign to 'arr[]' because it still holds an _Owned value; move or free it first}}
} // expected-error {{memory leak because 'p' is not freed or moved before it goes out of scope}}
