// RUN: %clang_cc1 -fbsc-diag=exhaustive -fbsc-experimental -verify %s

struct Foo {
  int a;
};

int struct Foo::getA(struct Foo* this) { // expected-note {{previous definition is here}}
  return this->a;
}

int struct Foo::getA(struct Foo* this) { // expected-error {{redefinition of 'getA'}}
  return this->a;
}

int main() {
  struct Foo foo = {.a = 1};
  foo.getA(); // expected-warning {{function 'main' was not analyzed because of earlier errors; fix the other errors and recompile}}
  return 0;
}