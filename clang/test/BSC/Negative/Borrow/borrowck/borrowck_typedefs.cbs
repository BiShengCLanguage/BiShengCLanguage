// RUN: %clang_cc1 -verify %s

typedef int *_Borrow IntBorrow;
typedef const int *_Borrow ConstIntBorrow;
typedef IntBorrow *_Borrow IntBorrowRef;
typedef IntBorrow const *_Borrow ConstIntBorrowRef;

typedef struct TypedefHolder {
  IntBorrowRef pp;
  IntBorrow p;
} TypedefHolder;

void use_holder(TypedefHolder h);
void use_int(int v);

void typedef_second_level_extends_original_object(void) {
  int a = 1;
  IntBorrow p = &_Mut a; // expected-note {{'a' is borrowed here}}
  IntBorrowRef q = &_Mut p;
  a = 2; // expected-error {{cannot assign to 'a' because it is borrowed}}
  **q = 3;
}

void typedef_mut_and_shared_reborrow_conflict(void) {
  int a = 1;
  IntBorrow p = &_Mut a;
  IntBorrowRef q1 = &_Mut p; // expected-note {{mutable borrow occurs here}}
  ConstIntBorrowRef q2 = &_Const p; // expected-error {{cannot borrow 'p' as immutable because it is also borrowed as mutable}}
  **q1 = 2;
  use_int(**q2);
}

void typedef_struct_holder_extends_original_object(void) {
  int a = 1;
  int b = 2;
  IntBorrow p = &_Mut a; // expected-note {{'a' is borrowed here}}
  TypedefHolder holder = { .pp = &_Mut p, .p = &_Mut b };
  a = 3; // expected-error {{cannot assign to 'a' because it is borrowed}}
  **holder.pp = 4;
}

void typedef_struct_holder_member_local_escape(void) {
  int a = 1;
  int b = 2;
  IntBorrow p = &_Mut a;
  TypedefHolder holder = { .pp = &_Mut p, .p = &_Mut b };
  {
    int local = 3;
    *holder.pp = &_Mut local; // expected-error {{'local' does not live long enough}}
  } // expected-note {{'local' dropped here while still borrowed}}
  **holder.pp = 4;
}

