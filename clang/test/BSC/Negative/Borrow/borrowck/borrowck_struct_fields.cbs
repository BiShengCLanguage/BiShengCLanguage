// RUN: %clang_cc1 -verify %s

typedef struct Inner {
  int value;
  int other;
} Inner;

typedef struct Outer {
  Inner inner;
  int tail;
  int items[4];
} Outer;

void use_mut(int *_Borrow p);
void use_int(int v);

void struct_field_reborrow_freezes_same_field(void) {
  Outer s = { .inner = { .value = 1, .other = 2 }, .tail = 3 };
  int *_Borrow p = &_Mut s.inner.value; // expected-note {{'s.inner.value' is borrowed here}}
  int *_Borrow *_Borrow q = &_Mut p;
  s.inner.value = 4; // expected-error {{cannot assign to 's.inner.value' because it is borrowed}}
  **q = 5;
}

void struct_field_reborrow_blocks_whole_struct_write(void) {
  Outer s = { .inner = { .value = 1, .other = 2 }, .tail = 3 };
  int *_Borrow p = &_Mut s.inner.value; // expected-note {{'s' is borrowed here}}
  int *_Borrow *_Borrow q = &_Mut p;
  s = (Outer){ .inner = { .value = 4, .other = 5 }, .tail = 6 };
  // expected-error@-1 {{cannot assign to 's' because it is borrowed}}
  **q = 7;
}

void struct_arrow_field_reborrow_freezes_same_field(void) {
  Outer s = { .inner = { .value = 1, .other = 2 }, .tail = 3 };
  Outer *raw = &s;
  int *_Borrow p = &_Mut raw->inner.value; // expected-note {{'(*raw).inner.value' is borrowed here}}
  int *_Borrow *_Borrow q = &_Mut p;
  raw->inner.value = 4; // expected-error {{cannot assign to '(*raw).inner.value' because it is borrowed}}
  **q = 5;
}

void struct_nested_field_conflicts_with_second_mut_borrow(void) {
  Outer s = { .inner = { .value = 1, .other = 2 }, .tail = 3 };
  int *_Borrow p = &_Mut s.inner.value; // expected-note {{first mut borrow occurs here}}
  int *_Borrow *_Borrow q = &_Mut p;
  int *_Borrow r = &_Mut s.inner.value; // expected-error {{cannot borrow 's.inner.value' as mutable more than once at a time}}
  **q = 4;
  *r = 5;
}

void struct_array_field_freezes_whole_array_field(void) {
  Outer s = { .inner = { .value = 1, .other = 2 }, .tail = 3,
              .items = {0, 1, 2, 3} };
  int *_Borrow _ArrayElem p = &_Mut s.items[0]; // expected-note {{'s.items[_]' is borrowed here}}
  int *_Borrow _ArrayElem *_Borrow q = &_Mut p;
  s.items[1] = 4; // expected-error {{cannot assign to 's.items[_]' because it is borrowed}}
  (*q)[0] = 5;
}

