// RUN: %clang_cc1 -fbsc-diag=exhaustive -fsyntax-only -verify %s

struct S1; // expected-note{{forward declaration of 'struct S1'}}
struct S2 { struct S1 s1; }; // expected-error{{field has incomplete type 'struct S1'}}
struct S3 { struct S2 s2; };
struct S1 { struct S3 s3; };

void test() {
  struct S1 s; // expected-warning{{function 'test' was not analyzed because of earlier errors; fix the other errors and recompile}}
  (void)s;
}
