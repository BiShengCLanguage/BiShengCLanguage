// RUN: %clang_cc1 -fbsc-diag=exhaustive -fsyntax-only -std=c11 -verify %s

struct S1; // expected-note{{forward declaration of 'struct S1'}}
struct S2 { struct S1 s1; }; // expected-error{{field has incomplete type 'struct S1'}}
struct S3 { struct S2 s2; };
struct S1 { struct S3 s3; };

_Atomic(struct S1) f(void) {} // expected-warning{{function 'f' was not analyzed because of earlier errors; fix the other errors and recompile}}

void g(_Atomic(struct S1) p) {} // expected-warning{{function 'g' was not analyzed because of earlier errors; fix the other errors and recompile}}
