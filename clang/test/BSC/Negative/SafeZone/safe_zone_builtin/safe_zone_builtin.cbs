// RUN: %clang_cc1 -fsyntax-only -verify -x bsc %s

// Builtins outside the whitelist remain forbidden in the safe zone.
_Safe double errno_builtin_is_rejected(double d) {
  return __builtin_sqrt(d); // expected-error {{_Unsafe function call is forbidden in the safe zone}}
}

_Safe double inexact_builtin_is_rejected(double d) {
  return __builtin_ceil(d); // expected-error {{_Unsafe function call is forbidden in the safe zone}}
}

_Safe unsigned long pointer_builtin_is_rejected(void *p) {
  return __builtin_object_size(p, 0); // expected-error {{_Unsafe function call is forbidden in the safe zone}}
}
