// RUN: %clang_cc1 -fsyntax-only -verify %s

_Safe void cb(void);
typedef _Safe void (*SafeFp)(void);

void t(void) {
  SafeFp arr[2] = {cb, cb};
  void (**q)(void) = arr; // expected-warning {{incompatible pointer types initializing 'void (**)(void)' with an expression of type 'SafeFp[2]' (aka '_Safe void (*[2])(void)')}}
  (void)q;
}
