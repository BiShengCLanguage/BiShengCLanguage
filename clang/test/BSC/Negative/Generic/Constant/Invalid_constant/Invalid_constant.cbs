// RUN: %clang_cc1 -verify %s

int foo_1<int N, int L>(int a) {
    int x = N;
    int y = L.f1;               // expected-error {{no member named 'f1' in type 'int'}}
    return x;
}

int foo_2<int B>(int a) {        // expected-note {{candidate template ignored: invalid explicitly-specified argument for template parameter 'B'}}
    int x = B;
    return x;
}

int foo_3<long int C>(int a) {   // expected-note {{candidate template ignored: invalid explicitly-specified argument for template parameter 'C'}}
    int x = C;
    return x;
}

float foo_4<float F>(int a) {   //  expected-error {{a non-type template parameter cannot have type 'float' before C++20}}
    float x = F;
    return x;
}

// Pointer types are not valid constant generic parameter types.
struct S<int *P> {};           // expected-error {{a non-type template parameter cannot have type 'int *'}}

typedef int *PI;
// Function templates must reject pointer aliases too.
void fn<PI P>(void);           // expected-error {{a non-type template parameter cannot have type 'PI'}}

enum E { A };

typedef enum E EA;
// An alias must not hide an enum parameter type.
struct U<EA N> {};             // expected-error {{a non-type template parameter cannot have type 'EA'}}

void fn1<char C>(void);
void fn2<_Bool B>(void);       // expected-error {{a non-type template parameter cannot have type '_Bool'}}

void fn3<int V[2]>(void);     // expected-error {{a non-type template parameter cannot have type 'int[2]'}}
typedef int Arr[2];
void fn4<Arr N>(void);         // expected-error {{a non-type template parameter cannot have type 'Arr'}}

typedef int F(void);
void fn5<F N>(void);           // expected-error {{a non-type template parameter cannot have type 'F'}}

int main() {
    int a = foo_2<3.15>(2);     // expected-error {{no matching function for call to 'foo_2'}}

    float x = 1.5;
    int b = foo_3<x>(2);        // expected-error {{no matching function for call to 'foo_3'}}
    return 0;
}
