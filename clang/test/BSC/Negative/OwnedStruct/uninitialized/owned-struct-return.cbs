// RUN: %clang_cc1 -fbsc-experimental -verify %s
_Owned struct A {  
   _Public:
   int x;
   int y ;
  ~A(A this){
  }
};                       
A foo(){
   A a;
   a.x = 1; // expected-error {{cannot assign to a field of 'a' because 'a' is uninitialized}}
   return a; // expected-error {{use of uninitialized value: 'a'}}
}

int main() {
   return 0;
}
