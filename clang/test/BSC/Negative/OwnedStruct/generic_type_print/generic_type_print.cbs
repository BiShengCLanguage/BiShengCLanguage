// RUN: %clang_cc1 -fsyntax-only -fbsc-experimental -verify %s

_Owned struct P { int y; };

// The substituted T prints its owned-struct tag once.
void take<T>(T *_Borrow l) {
  T *_Owned o = (T *_Owned)l; // expected-error {{incompatible _Owned types, cannot cast '_Owned struct P *_Borrow' to '_Owned struct P *_Owned'}}
  (void)o;
}

void use(P *_Borrow a) {
  take(a); // expected-note {{in instantiation of function template specialization 'take<_Owned struct P>' requested here}}
}
