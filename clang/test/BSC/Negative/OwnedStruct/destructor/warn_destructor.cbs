// RUN: %clang_cc1 -fbsc-experimental -verify %s

// RUN: %clang -fbsc-experimental %s -o %test.output
// RUN: %test.output
// RUN: %clang -fbsc-experimental -rewrite-bsc %s -o %t-rw.c
// RUN: %clang -fbsc-experimental %t-rw.c -o %t-rw.output
// RUN: %t-rw.output

int y = 0;
_Owned struct A {  
_Public:
   ~A(A this){
    y++;
   }
};

 int test_switch() {
    A a ={};
    int xx = 1;
    switch(xx) {
        A b = {}; // expected-warning {{destructor of 'b' may not run because the switch can jump over its initialization}}
        case 1: {
           A c ={};
           break;
        }
     }
     return 0;
}

int test_switch1<T>() {
    A a ={};
    int xx = 1;
    switch(xx) {
        A b1 = {}; // expected-warning {{destructor of 'b1' may not run because the switch can jump over its initialization}}
        case 1: {
           A c ={};
           return 1;
        }
     }
     return 0;
}
int main(void) {
    test_switch();
    test_switch1<int>();
    return y-4;
}

