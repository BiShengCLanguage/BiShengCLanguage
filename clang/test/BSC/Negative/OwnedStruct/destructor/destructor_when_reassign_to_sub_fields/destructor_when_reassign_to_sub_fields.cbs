// RUN: %clang_cc1 -fbsc-experimental -verify %s

_Owned struct A{
};
_Owned struct B{
    _Public:
    A a;
};
_Owned struct C{
    _Public:
    A a;
    B b;
};

int main(){
    A a1 = {};
    A a2 = {};
    A a3= {};
    A a4= {};
    B b1 ={.a=a1};
    B b2 ={.a=a2};
    C c1 = {.a=a3,.b=b1};
    c1.b = b2;// expected-error {{cannot assign to 'c1.b' because it still holds an _Owned value; move or free it first}}
    return 0;
}