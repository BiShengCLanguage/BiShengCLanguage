// RUN: %clang_cc1 -fbsc-experimental -verify %s

_Owned struct A {
    int a;
};

A A::init_a1(){
  A d ={2}; // expected-error {{'_Owned struct A' requires an explicit constructor because it has a _Private field}}
 return d;
}

int main() {
    A b = {.a=1}; // expected-error {{'_Owned struct A' requires an explicit constructor because it has a _Private field}}
    return 0;
}
