// RUN: %clang_cc1 -fbsc-experimental -verify %s

_Owned struct A {
    int a;
    int f(A this) { return this.a; } // expected-error {{cannot use a member of 'this' in a return expression because 'this' is destroyed before the return; copy the member to a local first}}
    int g(A this);
};

int A::q(int b, A* this); // expected-error {{'this' cannot be the name of a parameter}}

int A::o(int* this); // expected-error {{type of parameter 'this' is wrong, expected 'This*' or 'This' or '_Owned struct A*' or '_Owned struct A', but found 'int *'}}