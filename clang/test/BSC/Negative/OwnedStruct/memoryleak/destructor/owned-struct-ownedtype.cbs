// RUN: %clang_cc1 -fbsc-experimental -verify %s

void * malloc(unsigned long);
void free(void *);

struct A {
        long * _Owned b;
};

_Owned struct S {
_Public:
        short * _Owned x;
        struct A y;
        ~S(S this) {
                free(__move_to_raw(this.x));
        } // expected-error {{this.y.b is not freed in the destructor of '_Owned struct S'; _Owned fields must be freed or moved manually}}
};