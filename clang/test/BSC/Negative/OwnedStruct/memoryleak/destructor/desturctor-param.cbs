// RUN: %clang_cc1 -fbsc-experimental -verify %s
_Owned struct A {
    _Public:
    int * _Owned a;
    ~A(A this) {
    } // expected-error {{this.a is not freed in the destructor of '_Owned struct A'; _Owned fields must be freed or moved manually}}
};
int main() {
    int local = 1;
    A a ={ .a = __take_from_raw(&local) };
    return 0;
}
