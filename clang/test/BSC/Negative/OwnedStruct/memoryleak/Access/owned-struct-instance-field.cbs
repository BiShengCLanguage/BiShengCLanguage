// RUN: %clang_cc1 -fbsc-experimental -verify %s


_Owned struct A {
    _Public:
        int a;
};

int test1() {
    A a;
    a.a = 1;
    return (a.a - 1); // expected-error {{cannot use a member of 'a' in a return expression because 'a' is destroyed before the return; copy the member to a local first}}
}
int test2() {
    A a;
    a.a = 1;
    return a.a ; // expected-error {{cannot use a member of 'a' in a return expression because 'a' is destroyed before the return; copy the member to a local first}}
}

int test3() {
    A a;
    a.a = 1;
    return a.a - 1; // expected-error {{cannot use a member of 'a' in a return expression because 'a' is destroyed before the return; copy the member to a local first}}
}
int main() {

    return 0;
}
