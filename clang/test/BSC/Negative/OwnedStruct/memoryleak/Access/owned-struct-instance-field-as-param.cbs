// RUN: %clang_cc1 -fbsc-experimental -verify %s

 _Owned struct A {
  _Public:
   int a;
};

int foo(int x) {
    return x;
}
int main() {
   A a ={.a=1};
   a.a+=2;
   a.a = 3;
   foo(a.a);
   return foo(a.a);     // expected-error {{cannot use a member of 'a' in a return expression because 'a' is destroyed before the return; copy the member to a local first}}
}
