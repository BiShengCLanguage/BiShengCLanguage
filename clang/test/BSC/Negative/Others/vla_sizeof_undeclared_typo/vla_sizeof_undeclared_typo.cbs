// RUN: not %clang_cc1 -fsyntax-only -xbsc %s 2>&1 | FileCheck %s

// Case 1: 1-D VLA + undeclared function — the original crasher.
void f1(int len) {
    char buf[len + 1];
    int x = MIN(sizeof(buf), 5); // expected-error {{use of undeclared identifier 'MIN'}}
}

// Case 2: nested VLA (VLA of VLA) inside sizeof in an undeclared call.
void f2(int m, int n) {
    int grid[m][n];
    int x = MAX(sizeof(grid), 0); // expected-error {{use of undeclared identifier 'MAX'}}
}

// Case 3: sizeof(VLA) appears as a plain operand, typo is elsewhere —
// exercises the full-expression walk hitting the VLA operand.
void f3(int len) {
    char buf[len + 1];
    int x = UNDEF_FUNC(sizeof(buf) + 1); // expected-error {{use of undeclared identifier 'UNDEF_FUNC'}}
}

// Case 4: VLA typedef; isVariableArrayType() must still recognize the
// canonical (VLA) type without an explicit getCanonicalType() at the
// call site (matches CreateUnaryExprOrTypeTraitExpr's own check).
typedef int vla_t[len];  // expected-error {{variably modified type at file scope is not supported}}
vla_t *g_p;
void f4(int len) {
    vla_t arr;
    int x = BAD(sizeof(arr), 1); // expected-error {{use of undeclared identifier 'BAD'}}
}

// Case 5: undeclared identifier is itself an argument (not the callee),
// so the TypoExpr sits in arg position. Still walks sizeof(VLA) operand.
void f5(int len) {
    char buf[len + 1];
    int x = real_func(sizeof(buf), NONEXIST); // expected-error {{use of undeclared identifier 'NONEXIST'}}
}
void real_func(int, int);

// Case 6: undeclared identifier wrapped in parens; walks sizeof operand
// through TransformParenExpr too.
void f6(int len) {
    char buf[len + 1];
    int x = (WRAPPED)(sizeof(buf)); // expected-error {{use of undeclared identifier 'WRAPPED'}}
}

// Case 7: no typo at all — verify the fix does not regress the legitimate
// sizeof(VLA) path.
int real_strlen(const char *);
void f7(int len) {
    char buf[len + 1];
    int x = real_strlen(buf) + (int)sizeof(buf);
    (void)x;
}

// Case 8: VLA-typed parameter inside sizeof; the DRE refers to a
// ParmVarDecl rather than a local VarDecl.
void f8(int n, char buf[n]) {
    int x = BAD(sizeof(buf), 0); // expected-error {{use of undeclared identifier 'BAD'}}
    (void)x;
}

// --- Typo-correction success cases ---

// Case 9: callee typo with a near-name candidate
int real_min(int, int); // expected-note {{'real_min' declared here}}
void f9(int len) {
    char buf[len + 1];
    int x = real_mni(sizeof(buf), 5); // expected-error {{use of undeclared identifier 'real_mni'; did you mean 'real_min'?}}
    (void)x;
}

// Case 10: typo in argument position (not the callee)
int real_strlen(const char *); // expected-note {{'real_strlen' declared here}}
void f10(int len) {
    char buf[len + 1];
    int x = real_strlen(buf) + real_strlen(NULL);
    (void)x;
    // Use an arg-position typo to walk sizeof(VLA) again.
    int y = real_func(real_strlen, sizeof(buf)); // expected-error {{use of undeclared identifier 'real_func'}}
    (void)y;
}
void real_func(int (*)(const char *), unsigned long);

// Case 11: variable typo with a near-name candidate;
int counter; // expected-note {{'counter' declared here}}
void f11(int len) {
    char buf[len + 1];
    int x = cunter + (int)sizeof(buf); // expected-error {{use of undeclared identifier 'cunter'; did you mean 'counter'?}}
    (void)x;
}

// CHECK: use of undeclared identifier 'MIN'
// CHECK: use of undeclared identifier 'MAX'
// CHECK: use of undeclared identifier 'UNDEF_FUNC'
// CHECK: use of undeclared identifier 'BAD'
// CHECK: use of undeclared identifier 'NONEXIST'
// CHECK: use of undeclared identifier 'WRAPPED'
// CHECK: use of undeclared identifier 'BAD'
// CHECK: use of undeclared identifier 'real_mni'
// CHECK: use of undeclared identifier 'real_func'
// CHECK: use of undeclared identifier 'cunter'
// CHECK-NOT: Assertion `(!E || isa<FunctionParmPackExpr>(E))` failed
// CHECK-NOT: {{Assertion|STACK}}
