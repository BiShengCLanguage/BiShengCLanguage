// RUN: %clang_cc1 -fbsc-experimental -fsyntax-only -verify %s

_Trait F<T> {
  int foo(This* this);
};

int get(_Trait F<int>* f) {
  return 1;
};

int main() {
  int a = 1;
  int b = get(&a); // expected-error {{expected a pointer type which has implemented '_Trait F<int>', found 'int'}}
  return 0;
}
