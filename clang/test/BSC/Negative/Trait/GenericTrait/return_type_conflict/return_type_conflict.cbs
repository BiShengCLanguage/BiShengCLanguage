// RUN: %clang_cc1 -fbsc-experimental -fsyntax-only -verify %s

_Trait F<T> {
  T foo(This* this, T a);
};

struct S{
  int x;
};

float struct S::foo(struct S* this, int a) {
  return this->x;
}

_Impl _Trait F<int> for struct S;  // expected-error {{type of 'foo' conflicts with that of '_Trait F<int>'}}
                               