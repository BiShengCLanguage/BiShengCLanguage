// RUN: not %clang_cc1 -fbsc-experimental -fsyntax-only %s 2>&1 | FileCheck %s

// CHECK: error: expected a pointer type which has implemented '_Trait a *', found 'int'
// CHECK-NOT: Segmentation fault

_Trait a<>{}
void multi(int x, _Trait a<>int *_Borrow*, int y) {
    int b;
    multi(1, &b, 2);
}
