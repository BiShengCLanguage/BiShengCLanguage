// RUN: %clang_cc1 -fbsc-experimental -fsyntax-only -verify %s

_Trait F {
  int foo(This* this);
};

_Trait F* get() {
  int a = 1;
  return &a; // expected-error {{expected a pointer type which has implemented '_Trait F', found 'int'}}
};

int int::foo(int* this) {
  return 0;
}

_Impl _Trait F for int;

int main() {
  _Trait F* f = get();
  return 0;
}
